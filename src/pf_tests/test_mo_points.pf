module test_mo_points
  use funit
  use mo_kind, only: i1, i2, i4, i8, dp, sp
  use mo_grid, only: grid_t, cartesian, spherical, bottom_up
  use mo_netcdf, only: NcDataset, NcVariable, NcDimension
  use mo_points, only: points_t
  use mo_points_io, only: add_var, var, points_output_dataset, points_series_output_dataset, points_input_dataset, &
                          points_id_index, points_id_indices
  use mo_grid_io, only: daily, hourly, monthly, start_timestamp, center_timestamp, end_timestamp
  use mo_points_regridder, only: nearest_grid_to_points_t, nearest_points_to_grid_t, nearest_points_to_points_t
  use mo_datetime, only: datetime
  use mo_timeseries, only: time_t
  implicit none

  private

  public :: test_read_scc_gauges
  public :: test_points_netcdf_roundtrip
  public :: test_points_output_input
  public :: test_points_time_series_io
  public :: test_points_time_t_and_ids
  public :: test_points_polygon_mask
  public :: test_points_copy_to
  public :: test_points_destroy
  public :: test_point_regridder_destroy
  public :: test_nearest_regridding
  public :: test_points_cf_packing

contains

  @test
  subroutine test_points_polygon_mask()
    type(points_t) :: points, sph_points
    real(dp) :: polygon(4, 2), sph_polygon(4, 2)
    logical, allocatable :: mask(:)

    call points%init([0.5_dp, 1.5_dp, 2.5_dp, 3.5_dp, 1.5_dp], &
                     [0.5_dp, 0.5_dp, 1.5_dp, 2.5_dp, 1.5_dp], coordsys=cartesian)

    polygon(1, :) = [1.5_dp, 0.5_dp]
    polygon(2, :) = [2.5_dp, 0.5_dp]
    polygon(3, :) = [2.5_dp, 2.5_dp]
    polygon(4, :) = [1.5_dp, 2.5_dp]
    call points%polygon_mask(polygon, mask)

    @assertEqual(mask, [.false., .true., .true., .false., .true.], message='points polygon_mask includes inside and on boundary')

    call sph_points%init([-44.5_dp, -42.5_dp, 315.5_dp], [70.0_dp, 70.0_dp, 70.0_dp], coordsys=spherical)

    sph_polygon(1, :) = [-45.0_dp, 69.0_dp]
    sph_polygon(2, :) = [-43.0_dp, 69.0_dp]
    sph_polygon(3, :) = [-43.0_dp, 71.0_dp]
    sph_polygon(4, :) = [-45.0_dp, 71.0_dp]
    call sph_points%polygon_mask(sph_polygon, mask)

    @assertEqual(mask, [.true., .false., .false.], message='points polygon_mask uses stored spherical longitude convention')
  end subroutine test_points_polygon_mask

  @test
  subroutine test_points_copy_to()
    type(points_t) :: points, same, masked, boxed, both, empty, sph, sph_boxed
    logical :: point_mask(5), empty_mask(5)
    logical, allocatable :: selection(:)

    call points%init([0.0_dp, 1.0_dp, 2.0_dp, 3.0_dp, 4.0_dp], &
                     [0.0_dp, 1.0_dp, 2.0_dp, 3.0_dp, 4.0_dp], coordsys=cartesian)

    call points%copy_to(same)
    @assertTrue(points%is_matching(same), message='points copy_to without selection preserves coordinates')
    @assertEqual(same%coordsys, cartesian, message='points copy_to preserves coordinate system')

    point_mask = [.true., .false., .true., .false., .true.]
    call points%copy_to(masked, mask=point_mask)
    @assertEqual(masked%n_points, 3_i8, message='points copy_to mask updates point count')
    @assertEqual(masked%x, [0.0_dp, 2.0_dp, 4.0_dp], tolerance=1.0e-12_dp, message='points copy_to mask preserves source order')
    @assertEqual(masked%y, [0.0_dp, 2.0_dp, 4.0_dp], tolerance=1.0e-12_dp, message='points copy_to mask copies y')

    call points%copy_to(boxed, bbox=[1.0_dp, 1.0_dp, 3.0_dp, 3.0_dp])
    @assertEqual(boxed%x, [1.0_dp, 2.0_dp, 3.0_dp], tolerance=1.0e-12_dp, message='points copy_to bbox includes boundaries')
    @assertEqual(boxed%y, [1.0_dp, 2.0_dp, 3.0_dp], tolerance=1.0e-12_dp, message='points copy_to bbox copies y')

    call points%copy_to(both, mask=point_mask, bbox=[1.0_dp, 1.0_dp, 3.0_dp, 3.0_dp], selection=selection)
    @assertEqual(both%n_points, 1_i8, message='points copy_to combines mask and bbox')
    @assertEqual(both%x, [2.0_dp], tolerance=1.0e-12_dp, message='points copy_to combined selection copies x')
    @assertEqual(selection, [.false., .false., .true., .false., .false.], message='points copy_to returns generated selection')

    empty_mask = .false.
    call points%copy_to(empty, mask=empty_mask)
    @assertEqual(empty%n_points, 0_i8, message='points copy_to supports empty selections')
    @assertTrue(allocated(empty%x), message='points copy_to allocates empty x')
    @assertTrue(allocated(empty%y), message='points copy_to allocates empty y')

    call sph%init([-44.5_dp, -42.5_dp, 315.5_dp], [70.0_dp, 70.0_dp, 70.0_dp], coordsys=spherical)
    call sph%copy_to(sph_boxed, bbox=[-45.0_dp, 69.0_dp, -43.0_dp, 71.0_dp])
    @assertEqual(sph_boxed%x, [-44.5_dp], tolerance=1.0e-12_dp, message='points copy_to bbox uses stored longitudes')
    @assertEqual(sph_boxed%coordsys, spherical, message='points copy_to preserves spherical coordinate system')
  end subroutine test_points_copy_to

  @test
  subroutine test_read_scc_gauges()
    type(points_t), target :: points
    type(points_input_dataset) :: inp
    type(var), allocatable :: input_vars(:)
    integer(i4), allocatable :: ids(:)

    call points%from_netcdf("files/scc_gauges.nc", var="station")

    @assertEqual(points%coordsys, cartesian)
    @assertEqual(points%n_points, 3_i8)
    @assertEqual(size(points%x, kind=i8), 3_i8)
    @assertEqual(size(points%y, kind=i8), 3_i8)

    allocate(input_vars(0))
    call inp%init("files/scc_gauges.nc", vars=input_vars, points=points, points_init_var="station")
    call inp%get_ids(ids)
    call inp%close()
    @assertTrue(all(ids == [1_i4, 2_i4, 3_i4]))
  end subroutine test_read_scc_gauges

  @test
  subroutine test_points_netcdf_roundtrip()
    type(points_t) :: cart_points, sph_points, cart_read, sph_read
    type(NcDataset) :: nc
    type(NcVariable) :: var
    character(len=256) :: attr

    call cart_points%init([1.0_dp, 2.0_dp], [3.0_dp, 4.0_dp], coordsys=cartesian)
    call cart_points%to_netcdf("points_cart.nc")
    call cart_read%from_netcdf("points_cart.nc")
    @assertEqual(cart_read%coordsys, cartesian)
    @assertTrue(cart_read%is_matching(cart_points))
    @assertEqual(cart_read%x, cart_points%x, tolerance=1.0e-12_dp)
    @assertEqual(cart_read%y, cart_points%y, tolerance=1.0e-12_dp)

    call cart_read%init([1.0_dp + 1.0e-8_dp, 2.0_dp], [3.0_dp, 4.0_dp], coordsys=cartesian)
    @assertTrue(cart_read%is_matching(cart_points))
    @assertFalse(cart_read%is_matching(cart_points, tol=1.0e-10_dp))

    nc = NcDataset("points_cart.nc", "r")
    var = nc%getVariable("x")
    call var%getAttribute("standard_name", attr)
    @assertEqual(trim(attr), "projection_x_coordinate")
    call nc%close()

    call sph_points%init([10.0_dp, 11.0_dp], [50.0_dp, 51.0_dp], coordsys=spherical)
    call sph_points%to_netcdf("points_spherical.nc")
    call sph_read%from_netcdf("points_spherical.nc")
    @assertEqual(sph_read%coordsys, spherical)
    @assertEqual(sph_read%x, sph_points%x, tolerance=1.0e-12_dp)
    @assertEqual(sph_read%y, sph_points%y, tolerance=1.0e-12_dp)
    nc = NcDataset("points_spherical.nc", "r")
    var = nc%getVariable("lon")
    call var%getAttribute("standard_name", attr)
    @assertEqual(trim(attr), "longitude")
    call nc%close()
  end subroutine test_points_netcdf_roundtrip

  @test
  subroutine test_points_output_input()
    type(points_t), target :: points, points_read
    type(points_output_dataset) :: out
    type(points_input_dataset) :: inp
    type(time_t) :: time_axis
    type(var), allocatable :: vars(:)
    type(var), allocatable :: static_vars(:)
    type(var) :: meta
    real(dp) :: values(3), read_values(3)
    real(dp), allocatable :: read_chunk(:, :)
    real(sp) :: values_sp(3), read_sp(3)
    integer(i1) :: values_i1(3), read_i1(3)
    integer(i2) :: values_i2(3), read_i2(3)
    integer(i4) :: values_i4(3), read_i4(3)
    integer(i8) :: values_i8(3), read_i8(3)
    integer(i4), allocatable :: ids_i4(:)
    integer(i8), allocatable :: ids_i8(:)
    type(datetime) :: start_time, expected_time
    type(datetime), allocatable :: times(:)

    call points%init([1.0_dp, 2.0_dp, 3.0_dp], [4.0_dp, 5.0_dp, 6.0_dp], coordsys=cartesian)
    allocate(vars(0))
    call add_var(vars, var(name="discharge", units="m3 s-1", static=.false., dtype="f64", kind="dp"))

    start_time = datetime("1990-01-01")
    call out%init("point_discharge.nc", points=points, vars=vars, start_time=start_time, point_dim_name="node")
    meta = out%meta("discharge")
    @assertFalse(meta%static)
    @assertEqual(trim(meta%dtype), "f64")
    @assertEqual(trim(meta%kind), "dp")
    values = [10.0_dp, 20.0_dp, 30.0_dp]
    call out%update("discharge", values)
    call out%write(datetime("1990-01-02"))
    call out%close()

    call points_read%from_netcdf("point_discharge.nc", var="discharge")
    @assertEqual(points_read%n_points, 3_i8)
    @assertEqual(points_read%x, points%x, tolerance=1.0e-12_dp)
    call inp%init("point_discharge.nc", vars=vars, points=points_read)
    meta = inp%meta("discharge")
    @assertFalse(meta%static)
    @assertEqual(trim(meta%dtype), "f64")
    @assertEqual(trim(meta%kind), "dp")
    @assertEqual(trim(meta%units), "m3 s-1")
    time_axis = inp%time_axis()
    @assertEqual(time_axis%n_times(), 1_i4)
    @assertEqual(time_axis%values, inp%t_values)
    @assertEqual(time_axis%bounds(1_i4, :), inp%t_bounds(:size(inp%t_values)))
    @assertEqual(time_axis%bounds(2_i4, :), inp%t_bounds(2_i4:))
    @assertEqual(trim(time_axis%units), trim(inp%time_units))
    call inp%read("discharge", read_values, current_time=datetime("1990-01-02"))
    @assertEqual(read_values, values, tolerance=1.0e-12_dp)
    call inp%read_chunk("discharge", read_chunk, datetime("1990-01-01"), datetime("1990-01-02"), times)
    call inp%close()
    @assertEqual(shape(read_chunk), [3_i4, 1_i4])
    @assertEqual(read_chunk(:, 1), values, tolerance=1.0e-12_dp)
    @assertEqual(size(times), 1)
    expected_time = datetime("1990-01-02")
    @assertEqual(times(1)%str(), expected_time%str())

    allocate(static_vars(0))
    call add_var(static_vars, var(name="height_sp", static=.true., dtype="f32", kind="sp"))
    call add_var(static_vars, var(name="code_i1", static=.true., dtype="i8", kind="i1"))
    call add_var(static_vars, var(name="code_i2", static=.true., dtype="i16", kind="i2"))
    call add_var(static_vars, var(name="code_i4", static=.true., dtype="i32", kind="i4"))
    call add_var(static_vars, var(name="code_i8", static=.true., dtype="i64", kind="i8"))
    call out%init("point_static_kinds.nc", points=points, vars=static_vars)
    meta = out%meta("height_sp")
    @assertTrue(meta%static)
    @assertEqual(trim(meta%dtype), "f32")
    @assertEqual(trim(meta%kind), "sp")
    values_sp = [1.0_sp, 2.0_sp, 3.0_sp]
    values_i1 = [1_i1, 2_i1, 3_i1]
    values_i2 = [10_i2, 20_i2, 30_i2]
    values_i4 = [100_i4, 200_i4, 300_i4]
    values_i8 = [1000_i8, 2000_i8, 3000_i8]
    call out%update("height_sp", values_sp)
    call out%update("code_i1", values_i1)
    call out%update("code_i2", values_i2)
    call out%update("code_i4", values_i4)
    call out%update("code_i8", values_i8)
    call out%write_static()
    call out%close()

    call inp%init("point_static_kinds.nc", vars=static_vars, points=points)
    call inp%read("height_sp", read_sp)
    call inp%read("code_i1", read_i1)
    call inp%read("code_i2", read_i2)
    call inp%read("code_i4", read_i4)
    call inp%read("code_i8", read_i8)
    call inp%get_ids(ids_i4, id_name="code_i4")
    call inp%get_ids(ids_i8)
    call inp%close()
    @assertEqual(read_sp, values_sp, tolerance=1.0e-6_sp)
    @assertTrue(all(read_i1 == values_i1))
    @assertTrue(all(read_i2 == values_i2))
    @assertTrue(all(read_i4 == values_i4))
    @assertTrue(all(read_i8 == values_i8))
    @assertTrue(all(ids_i4 == values_i4))
    @assertTrue(all(ids_i8 == [1_i8, 2_i8, 3_i8]))
  end subroutine test_points_output_input

  @test
  subroutine test_points_time_series_io()
    type(points_t), target :: points, points_read
    type(points_output_dataset) :: out
    type(points_series_output_dataset) :: series_out
    type(points_input_dataset) :: inp
    type(var), allocatable :: vars(:)
    type(var), allocatable :: mixed_vars(:)
    type(NcDataset) :: nc
    type(NcVariable) :: nc_var, time_var, bnds_var
    type(NcDimension) :: node_dim, time_dim, bnds_dim
    type(NcDimension), allocatable :: dims(:)
    type(time_t) :: time_axis
    type(var) :: meta
    real(dp) :: values_1(3), values_2(3), read_values(3)
    real(dp), allocatable :: read_chunk(:, :), read_series_matrix(:, :), read_series(:)
    real(dp) :: slice_data(3, 2), series_data(2, 3)
    integer(i4) :: codes_1(3), codes_2(3), station_ids(3)
    integer(i4), allocatable :: read_codes(:), read_station_ids(:)
    integer(i4) :: tvals(2), tbnds(2, 2)
    character(len=64) :: dim_name
    type(datetime), allocatable :: times(:)

    call points%init([1.0_dp, 2.0_dp, 3.0_dp], [4.0_dp, 5.0_dp, 6.0_dp], coordsys=cartesian)
    allocate(vars(0))
    call add_var(vars, var(name="discharge", units="m3 s-1", static=.false., dtype="f64", kind="dp"))

    call out%init("point_discharge_series_layout.nc", points=points, vars=vars, start_time=datetime("1990-01-01"), &
                  point_dim_name="node", time_series=.true.)
    values_1 = [10.0_dp, 20.0_dp, 30.0_dp]
    values_2 = [11.0_dp, 21.0_dp, 31.0_dp]
    call out%update("discharge", values_1)
    call out%write(datetime("1990-01-02"))
    call out%update("discharge", values_2)
    call out%write(datetime("1990-01-03"))
    call out%close()

    nc = NcDataset("point_discharge_series_layout.nc", "r")
    nc_var = nc%getVariable("discharge")
    dims = nc_var%getDimensions()
    dim_name = dims(1)%getName()
    @assertEqual(trim(dim_name), "time")
    dim_name = dims(2)%getName()
    @assertEqual(trim(dim_name), "node")
    call nc%close()

    call points_read%from_netcdf("point_discharge_series_layout.nc", var="discharge")
    call inp%init("point_discharge_series_layout.nc", vars=vars, points=points_read)
    @assertTrue(inp%is_time_series_layout("discharge"))
    call inp%read("discharge", read_values, current_time=datetime("1990-01-02"))
    @assertEqual(read_values, values_1, tolerance=1.0e-12_dp)
    call inp%read_chunk("discharge", read_chunk, datetime("1990-01-01"), datetime("1990-01-03"))
    @assertEqual(shape(read_chunk), [3_i4, 2_i4])
    @assertEqual(read_chunk(:, 2), values_2, tolerance=1.0e-12_dp)
    call inp%read_series("discharge", read_series_matrix, datetime("1990-01-01"), datetime("1990-01-03"))
    @assertEqual(shape(read_series_matrix), [2_i4, 3_i4])
    @assertEqual(read_series_matrix(2, :), values_2, tolerance=1.0e-12_dp)
    call inp%read_series("discharge", 2_i8, read_series, times=times)
    call inp%close()
    @assertEqual(read_series, [20.0_dp, 21.0_dp], tolerance=1.0e-12_dp)
    @assertEqual(size(times), 2)

    tvals = [1_i4, 2_i4]
    tbnds(:, 1) = [0_i4, 1_i4]
    tbnds(:, 2) = [1_i4, 2_i4]
    call time_axis%init_cf(tvals, "days since 1990-01-01 00:00:00", bounds=tbnds)
    allocate(mixed_vars(0))
    call add_var(mixed_vars, var(name="discharge", units="m3 s-1", static=.false., dtype="f64", kind="dp"))
    call add_var(mixed_vars, var(name="code", static=.false., dtype="i32", kind="i4"))
    call series_out%init("point_series_writer.nc", points=points, vars=mixed_vars, time_axis=time_axis, point_dim_name="station")
    meta = series_out%meta("code")
    @assertFalse(meta%static)
    @assertEqual(trim(meta%dtype), "i32")
    @assertEqual(trim(meta%kind), "i4")
    station_ids = [101_i4, 102_i4, 103_i4]
    call series_out%set_ids(station_ids, long_name="station ID")
    call series_out%write_series("discharge", 1_i8, [100.0_dp, 101.0_dp])
    call series_out%write_series("discharge", 2_i8, [200.0_dp, 201.0_dp])
    call series_out%write_series("discharge", 3_i8, [300.0_dp, 301.0_dp])
    codes_1 = [1_i4, 2_i4, 3_i4]
    codes_2 = [4_i4, 5_i4, 6_i4]
    call series_out%write_series("code", 1_i8, [codes_1(1), codes_2(1)])
    call series_out%write_series("code", 2_i8, [codes_1(2), codes_2(2)])
    call series_out%write_series("code", 3_i8, [codes_1(3), codes_2(3)])
    call series_out%close()

    call inp%init("point_series_writer.nc", vars=mixed_vars, points=points)
    time_axis = inp%time_axis()
    @assertEqual(time_axis%values, tvals)
    @assertEqual(time_axis%bounds, tbnds)
    @assertEqual(trim(time_axis%units), "days since 1990-01-01 00:00:00")
    call inp%read_series("discharge", read_series_matrix)
    @assertEqual(shape(read_series_matrix), [2_i4, 3_i4])
    @assertEqual(read_series_matrix(1, :), [100.0_dp, 200.0_dp, 300.0_dp], tolerance=1.0e-12_dp)
    @assertEqual(read_series_matrix(2, :), [101.0_dp, 201.0_dp, 301.0_dp], tolerance=1.0e-12_dp)
    call inp%read_series("discharge", 3_i8, read_series)
    @assertEqual(read_series, [300.0_dp, 301.0_dp], tolerance=1.0e-12_dp)
    call inp%read_series("code", 2_i8, read_codes)
    @assertTrue(all(read_codes == [2_i4, 5_i4]))
    call inp%get_ids(read_station_ids)
    @assertTrue(all(read_station_ids == station_ids))
    call inp%close()

    series_data(1, :) = [10.0_dp, 20.0_dp, 30.0_dp]
    series_data(2, :) = [11.0_dp, 21.0_dp, 31.0_dp]
    call series_out%init("point_series_matrix_writer.nc", points=points, vars=vars, time_axis=time_axis, point_dim_name="station")
    call series_out%write_series("discharge", series_data)
    call series_out%close()

    call inp%init("point_series_matrix_writer.nc", vars=vars, points=points)
    call inp%read_series("discharge", read_series_matrix)
    @assertEqual(read_series_matrix, series_data, tolerance=1.0e-12_dp)
    call inp%close()

    call time_axis%init_cf([372_i4, 1092_i4], "hours since 2000-01-01 00:00:00")
    call series_out%init("point_series_instant_writer.nc", points=points, vars=vars, time_axis=time_axis, point_dim_name="station")
    call series_out%write_series("discharge", 1_i8, [10.0_dp, 11.0_dp])
    call series_out%write_series("discharge", 2_i8, [20.0_dp, 21.0_dp])
    call series_out%write_series("discharge", 3_i8, [30.0_dp, 31.0_dp])
    call series_out%close()

    nc = NcDataset("point_series_instant_writer.nc", "r")
    @assertFalse(nc%hasVariable("time_bnds"))
    time_var = nc%getVariable("time")
    @assertFalse(time_var%hasAttribute("bounds"))
    nc_var = nc%getVariable("discharge")
    dims = nc_var%getDimensions()
    dim_name = dims(1)%getName()
    @assertEqual(trim(dim_name), "time")
    dim_name = dims(2)%getName()
    @assertEqual(trim(dim_name), "station")
    call nc%close()

    call inp%init("point_series_instant_writer.nc", vars=vars, points=points)
    call inp%read_series("discharge", 2_i8, read_series)
    @assertEqual(read_series, [20.0_dp, 21.0_dp], tolerance=1.0e-12_dp)
    call inp%close()

    call inp%init("point_series_instant_writer.nc", vars=vars, points=points, timestamp=center_timestamp)
    time_axis = inp%time_axis()
    @assertEqual(time_axis%timestep, monthly)
    @assertEqual(time_axis%bounds(:, 1_i4), [0_i4, 744_i4])
    @assertEqual(time_axis%bounds(:, 2_i4), [744_i4, 1440_i4])
    call inp%close()

    nc = NcDataset("point_mixed_layout.nc", "w")
    call points%to_netcdf(nc, point_dim_name="node")
    node_dim = nc%getDimension("node")
    time_dim = nc%setDimension("time", 2_i4)
    bnds_dim = nc%setDimension("bnds", 2_i4)
    time_var = nc%setVariable("time", "f64", [time_dim])
    call time_var%setAttribute("standard_name", "time")
    call time_var%setAttribute("axis", "T")
    call time_var%setAttribute("units", "days since 1990-01-01 00:00:00")
    call time_var%setAttribute("bounds", "time_bnds")
    call time_var%setData(tvals)
    bnds_var = nc%setVariable("time_bnds", "f64", [bnds_dim, time_dim])
    call bnds_var%setData(tbnds)
    nc_var = nc%setVariable("slice", "f64", [node_dim, time_dim])
    call nc_var%setAttribute("coordinates", "x y")
    slice_data(:, 1) = [1.0_dp, 2.0_dp, 3.0_dp]
    slice_data(:, 2) = [4.0_dp, 5.0_dp, 6.0_dp]
    call nc_var%setData(slice_data)
    nc_var = nc%setVariable("series", "f64", [time_dim, node_dim])
    call nc_var%setAttribute("coordinates", "x y")
    series_data(1, :) = [10.0_dp, 20.0_dp, 30.0_dp]
    series_data(2, :) = [11.0_dp, 21.0_dp, 31.0_dp]
    call nc_var%setData(series_data)
    call nc%close()

    deallocate(mixed_vars)
    allocate(mixed_vars(0))
    call add_var(mixed_vars, var(name="slice", static=.false., dtype="f64", kind="dp"))
    call add_var(mixed_vars, var(name="series", static=.false., dtype="f64", kind="dp"))
    call inp%init("point_mixed_layout.nc", vars=mixed_vars, points=points)
    @assertFalse(inp%is_time_series_layout("slice"))
    @assertTrue(inp%is_time_series_layout("series"))
    call inp%read("slice", read_values, current_time=datetime("1990-01-03"))
    @assertEqual(read_values, slice_data(:, 2), tolerance=1.0e-12_dp)
    call inp%read("series", read_values, current_time=datetime("1990-01-02"))
    @assertEqual(read_values, series_data(1, :), tolerance=1.0e-12_dp)
    call inp%read_series("slice", read_series_matrix, datetime("1990-01-01"), datetime("1990-01-03"))
    @assertEqual(shape(read_series_matrix), [2_i4, 3_i4])
    @assertEqual(read_series_matrix, transpose(slice_data), tolerance=1.0e-12_dp)
    call inp%read_series("series", read_series_matrix, datetime("1990-01-01"), datetime("1990-01-03"))
    @assertEqual(shape(read_series_matrix), [2_i4, 3_i4])
    @assertEqual(read_series_matrix, series_data, tolerance=1.0e-12_dp)
    call inp%read_series("series", 2_i8, read_series)
    @assertEqual(read_series, [20.0_dp, 21.0_dp], tolerance=1.0e-12_dp)
    call inp%close()
  end subroutine test_points_time_series_io

  @test
  subroutine test_points_time_t_and_ids()
    type(time_t) :: time_axis
    integer(i4), allocatable :: values(:), bounds(:, :)
    integer(i8) :: idx
    integer(i8) :: indices(2)
    character(:), allocatable :: units

    call time_axis%init(datetime("1990-01-01"), datetime("1990-01-03"), timestep=daily, timestamp=end_timestamp)
    call time_axis%to_cf(values, bounds, units)
    @assertEqual(values, [1_i4, 2_i4])
    @assertEqual(bounds(:, 1), [0_i4, 1_i4])
    @assertEqual(trim(units), "days since 1990-01-01 00:00:00")

    call time_axis%init(datetime("1990-01-01"), datetime("1990-01-01 02:00:00"), timestep=hourly, timestamp=center_timestamp)
    call time_axis%to_cf(values, bounds, units)
    @assertEqual(values, [30_i4, 90_i4])
    @assertEqual(bounds(:, 2), [60_i4, 120_i4])
    @assertEqual(trim(units), "minutes since 1990-01-01 00:00:00")

    call time_axis%init(datetime("1990-01-01"), datetime("1990-01-03"), timestep=daily, &
                        timestamp=start_timestamp, ref_time=datetime("1989-12-31"))
    call time_axis%to_cf(values, bounds, units)
    @assertEqual(values, [1_i4, 2_i4])
    @assertEqual(trim(units), "days since 1989-12-31 00:00:00")

    idx = points_id_index([11_i4, 22_i4, 33_i4], 22_i4)
    @assertEqual(idx, 2_i8)
    indices = points_id_indices([11_i8, 22_i8, 33_i8], [33_i8, 11_i8])
    @assertEqual(indices, [3_i8, 1_i8])
  end subroutine test_points_time_t_and_ids

  @test
  subroutine test_points_cf_packing()
    use, intrinsic :: ieee_arithmetic, only: ieee_quiet_nan, ieee_value
    use mo_constants, only: nodata_dp, nodata_sp, nodata_i4
    implicit none
    type(points_t), target :: points
    type(points_output_dataset) :: out
    type(points_series_output_dataset) :: series_out
    type(points_input_dataset) :: inp
    type(NcDataset) :: nc
    type(NcVariable) :: nc_var
    type(NcDimension) :: point_dim
    type(time_t) :: axis
    type(var), allocatable :: vars(:), series_vars(:), integer_vars(:)
    type(var) :: meta
    real(sp) :: sp_factor(3), sp_double(3), read_sp(3)
    real(dp) :: dp_offset(3), dp_double(3), read_dp(3)
    real(dp) :: expected_validity(3)
    real(dp) :: series_data(2, 3)
    real(dp), allocatable :: series_read(:, :)
    integer(i2) :: raw(3)
    integer(i4) :: read_i4(3), tvals(2), tbnds(2, 2)
    integer(i4), allocatable :: series_read_i4(:, :), series_one_i4(:)

    call points%init([1.0_dp, 2.0_dp, 3.0_dp], [4.0_dp, 5.0_dp, 6.0_dp], coordsys=cartesian)
    allocate(vars(0))
    call add_var(vars, var(name="sp_f32", static=.true., dtype="i16", kind="sp", &
                           scale_factor=0.5_dp))
    call add_var(vars, var(name="sp_f64", static=.true., dtype="i16", kind="sp", scale_dtype="f64", &
                           scale_factor=0.5_dp, add_offset=10.0_dp))
    call add_var(vars, var(name="dp_f32", static=.true., dtype="i16", scale_dtype="f32", &
                           add_offset=10.0_dp))
    call add_var(vars, var(name="dp_f64", static=.true., dtype="i32", &
                           scale_factor=0.25_dp, add_offset=100.0_dp))

    sp_factor = [1.0_sp, 2.0_sp, nodata_sp]
    sp_double = [10.0_sp, 10.5_sp, 11.0_sp]
    dp_offset = [10.0_dp, 11.0_dp, 12.0_dp]
    dp_double = [100.0_dp, 100.25_dp, ieee_value(0.0_dp, ieee_quiet_nan)]
    call out%init("point_cf_packing.nc", points=points, vars=vars)
    meta = out%meta("sp_f32")
    @assertEqual(trim(meta%scale_dtype), "f32")
    meta = out%meta("dp_f32")
    @assertEqual(trim(meta%kind), "dp", message="explicit scale dtype does not change omitted kind")
    meta = out%meta("dp_f64")
    @assertEqual(trim(meta%scale_dtype), "f64", message="scale dtype follows default dp kind")
    call out%update("sp_f32", sp_factor)
    call out%update("sp_f64", sp_double)
    call out%update("dp_f32", dp_offset)
    call out%update("dp_f64", dp_double)
    call out%write_static()
    call out%close()

    nc = NcDataset("point_cf_packing.nc", "r")
    nc_var = nc%getVariable("sp_f32")
    @assertEqual(trim(nc_var%getAttributeDtype("scale_factor")), "f32")
    @assertFalse(nc_var%hasAttribute("add_offset"), message="factor-only output omits add_offset")
    call nc_var%readInto(raw)
    @assertTrue(all(raw == [2_i2, 4_i2, -9999_i2]), message="point writer stores raw integer codes")
    nc_var = nc%getVariable("sp_f64")
    @assertEqual(trim(nc_var%getAttributeDtype("scale_factor")), "f64")
    nc_var = nc%getVariable("dp_f32")
    @assertFalse(nc_var%hasAttribute("scale_factor"), message="offset-only output omits scale_factor")
    @assertEqual(trim(nc_var%getAttributeDtype("add_offset")), "f32")
    call nc%close()

    call inp%init("point_cf_packing.nc", vars=vars, points=points)
    meta = inp%meta("dp_f32")
    @assertEqual(trim(meta%kind), "dp")
    @assertEqual(trim(meta%scale_dtype), "f32")
    call inp%read("sp_f32", read_dp)
    @assertEqual(read_dp, real(sp_factor, dp), tolerance=1.0e-12_dp)
    @assertEqual(read_dp(3), nodata_dp)
    call inp%read("sp_f64", read_dp)
    @assertEqual(read_dp, real(sp_double, dp), tolerance=1.0e-12_dp)
    call inp%read("dp_f32", read_sp)
    @assertEqual(read_sp, real(dp_offset, sp), tolerance=1.0e-6_sp)
    call inp%read("dp_f64", read_sp)
    @assertEqual(read_sp, [100.0_sp, 100.25_sp, nodata_sp], tolerance=1.0e-6_sp)
    call inp%read("sp_f64", read_i4)
    @assertEqual(read_i4, [10_i4, 10_i4, 11_i4], message="packed point values truncate toward zero into integers")
    call inp%read("dp_f64", read_i4)
    @assertEqual(read_i4, [100_i4, 100_i4, nodata_i4], message="packed point missing maps to integer nodata")
    call inp%close()

    allocate(integer_vars(0))
    call add_var(integer_vars, var(name="sp_f64", static=.true., kind="i4"))
    call inp%init("point_cf_packing.nc", vars=integer_vars, points=points)
    meta = inp%meta("sp_f64")
    @assertEqual(trim(meta%kind), "i4", message="packed input permits integer metadata kind")
    call inp%read("sp_f64", read_i4)
    call inp%close()
    @assertEqual(read_i4, [10_i4, 10_i4, 11_i4])

    tvals = [1_i4, 2_i4]
    tbnds(:, 1) = [0_i4, 1_i4]
    tbnds(:, 2) = [1_i4, 2_i4]
    call axis%init_cf(tvals, "days since 2000-01-01 00:00:00", bounds=tbnds)
    allocate(series_vars(0))
    call add_var(series_vars, var(name="series", dtype="i16", scale_factor=0.5_dp, add_offset=0.0_dp))
    series_data(1, :) = [1.0_dp, 2.0_dp, 3.0_dp]
    series_data(2, :) = [1.5_dp, 2.5_dp, 3.5_dp]
    call series_out%init("point_cf_packing_series.nc", points=points, vars=series_vars, time_axis=axis)
    call series_out%write_series("series", series_data)
    call series_out%close()
    call inp%init("point_cf_packing_series.nc", vars=series_vars, points=points)
    call inp%read_series("series", series_read)
    call inp%read_series("series", series_read_i4)
    call inp%read_series("series", 2_i8, series_one_i4)
    call inp%close()
    @assertEqual(series_read, series_data, tolerance=1.0e-12_dp)
    @assertEqual(series_read_i4, reshape([1_i4, 1_i4, 2_i4, 2_i4, 3_i4, 3_i4], [2_i4, 3_i4]))
    @assertEqual(series_one_i4, [2_i4, 2_i4], message="packed single-point series read into integers")

    nc = NcDataset("point_cf_packing_validity.nc", "w")
    call points%to_netcdf(nc)
    point_dim = nc%getDimension("point")
    nc_var = nc%setVariable("validity", "i16", [point_dim])
    call nc_var%setAttribute("scale_factor", 0.5_sp)
    call nc_var%setAttribute("add_offset", 100.0_sp)
    call nc_var%setAttribute("valid_min", 0_i2)
    raw = [-10_i2, 0_i2, 10_i2]
    call nc_var%setData(raw)
    call nc%close()
    deallocate(vars)
    allocate(vars(0))
    call add_var(vars, var(name="validity", static=.true.))
    call inp%init("point_cf_packing_validity.nc", vars=vars, points=points)
    call inp%read("validity", read_dp)
    call inp%close()
    expected_validity = [nodata_dp, 100.0_dp, 105.0_dp]
    @assertEqual(read_dp, expected_validity, tolerance=1.0e-12_dp, message="packed validity limits apply before unpacking")
  end subroutine test_points_cf_packing

  @test
  subroutine test_nearest_regridding()
    type(grid_t), target :: grid
    type(points_t), target :: target_points, source_points, target_points_2
    type(nearest_grid_to_points_t) :: grid_to_points
    type(nearest_points_to_grid_t) :: points_to_grid
    type(nearest_points_to_points_t) :: points_to_points
    real(dp) :: grid_data(4), point_data(3), out_points(3), out_grid(4), out_points_2(2)

    call grid%init(nx=2_i4, ny=2_i4, xllcorner=0.0_dp, yllcorner=0.0_dp, cellsize=1.0_dp, &
                   coordsys=cartesian, y_direction=bottom_up)
    call target_points%init([0.45_dp, 1.45_dp, 0.45_dp], [0.45_dp, 0.45_dp, 1.45_dp], coordsys=cartesian)
    grid_data = [1.0_dp, 2.0_dp, 3.0_dp, 4.0_dp]
    call grid_to_points%init(source_grid=grid, target_points=target_points)
    call grid_to_points%execute(grid_data, out_points)
    @assertEqual(out_points, [1.0_dp, 2.0_dp, 3.0_dp], tolerance=1.0e-12_dp)

    call source_points%init([0.0_dp, 2.0_dp, 4.0_dp], [0.0_dp, 0.0_dp, 0.0_dp], coordsys=cartesian)
    call target_points_2%init([0.2_dp, 3.6_dp], [0.0_dp, 0.0_dp], coordsys=cartesian)
    point_data = [5.0_dp, 6.0_dp, 7.0_dp]
    call points_to_points%init(source_points=source_points, target_points=target_points_2)
    call points_to_points%execute(point_data, out_points_2)
    @assertEqual(out_points_2, [5.0_dp, 7.0_dp], tolerance=1.0e-12_dp)

    call points_to_grid%init(source_points=source_points, target_grid=grid)
    call points_to_grid%execute(point_data, out_grid)
    @assertEqual(out_grid, [5.0_dp, 6.0_dp, 5.0_dp, 6.0_dp], tolerance=1.0e-12_dp)
  end subroutine test_nearest_regridding

  @test
  subroutine test_points_destroy()
    type(points_t) :: points

    call points%destroy()
    call points%destroy()
    @assertEqual(points%n_points, 0_i8)

    call points%init([1.0_dp, 2.0_dp], [3.0_dp, 4.0_dp], coordsys=spherical)
    call points%destroy()
    call points%destroy()
    @assertEqual(points%n_points, 0_i8)
    @assertEqual(points%coordsys, cartesian)
    @assertFalse(allocated(points%x))
    @assertFalse(allocated(points%y))

    call points%init([5.0_dp], [6.0_dp])
    @assertEqual(points%n_points, 1_i8)
    @assertEqual(points%x(1), 5.0_dp, tolerance=0.0_dp)
  end subroutine test_points_destroy

  @test
  subroutine test_point_regridder_destroy()
    type(grid_t), target :: grid
    type(points_t), target :: points
    type(nearest_grid_to_points_t) :: grid_to_points
    type(nearest_points_to_grid_t) :: points_to_grid
    type(nearest_points_to_points_t) :: points_to_points
    real(dp) :: result(1)

    call grid_to_points%destroy()
    call points_to_grid%destroy()
    call points_to_points%destroy()
    call grid%init(nx=1_i4, ny=1_i4, cellsize=1.0_dp)
    call points%init([0.5_dp], [0.5_dp])

    call grid_to_points%init(grid, points)
    call points_to_grid%init(points, grid)
    call points_to_points%init(points, points)
    @assertTrue(allocated(grid_to_points%id_map))
    @assertTrue(allocated(points_to_grid%id_map))
    @assertTrue(allocated(points_to_points%id_map))

    call grid_to_points%destroy()
    call points_to_grid%destroy()
    call points_to_points%destroy()
    call grid_to_points%destroy()
    call points_to_grid%destroy()
    call points_to_points%destroy()
    @assertFalse(allocated(grid_to_points%id_map))
    @assertFalse(allocated(points_to_grid%id_map))
    @assertFalse(allocated(points_to_points%id_map))
    @assertFalse(associated(grid_to_points%source_grid))
    @assertFalse(associated(grid_to_points%target_points))
    @assertFalse(associated(points_to_grid%source_points))
    @assertFalse(associated(points_to_grid%target_grid))
    @assertFalse(associated(points_to_points%source_points))
    @assertFalse(associated(points_to_points%target_points))
    @assertEqual(grid%ncells, 1_i8)
    @assertEqual(points%n_points, 1_i8)

    call grid_to_points%init(grid, points)
    call grid_to_points%execute([2.0_dp], result)
    @assertEqual(result, [2.0_dp], tolerance=0.0_dp)
    call points_to_grid%init(points, grid)
    call points_to_grid%execute([3.0_dp], result)
    @assertEqual(result, [3.0_dp], tolerance=0.0_dp)
    call points_to_points%init(points, points)
    call points_to_points%execute([4.0_dp], result)
    @assertEqual(result, [4.0_dp], tolerance=0.0_dp)
  end subroutine test_point_regridder_destroy

end module test_mo_points
