module test_mo_grid_scaler
  use funit
  use mo_grid, only: grid_t, cartesian, spherical, top_down, bottom_up
  use mo_grid_scaler, only: scaler_t, nearest_regridder_t, up_a_mean, up_h_mean, up_p_mean, up_min, up_max, up_sum, &
                            up_var, up_std, up_laf, up_fraction, up_median, down_nearest, down_split, weight_area, weight_count, no_scaling
  use mo_kind, only: i4, dp, i8
  use mo_utils, only: flip, flipped, is_close
  use mo_constants, only: nodata_dp, nodata_i4, nodata_i8
  ! use mo_netcdf, only: NcDataset, NcVariable, NcDimension
  implicit none

  private

  public :: test_regrid
  public :: test_downscale_modes
  public :: test_no_scaling_identity
  public :: test_no_scaling_operators
  public :: test_stats_and_weight_count
  public :: test_area_weight_normalization
  public :: test_scaler_reinitialization
  public :: test_mapping_destroy
  public :: test_median_masked
  public :: test_laf_masked_direct_and_packed
  public :: test_fill_missing
  public :: test_nearest_regridder_matching_flipped
  public :: test_nearest_regridder_cartesian
  public :: test_nearest_regridder_masked_and_aux
  public :: test_nearest_regridder_spherical_and_mixed
  public :: test_nearest_regridder_derived_mask_cartesian
  public :: test_nearest_regridder_derived_mask_spherical_aux

  public :: test_offset_meteo_downscaling
  public :: test_offset_upscaling
  public :: test_offset_equal_resolution
  public :: test_derived_rectangle_scaling
  public :: test_offset_masked_downscaling
  public :: test_periodic_regional_scaling

  public :: test_equal_target_contract, test_equal_geometry_contract
  public :: test_equal_representations, test_equal_missing_representations

contains

  @test
  subroutine test_equal_target_contract()
    type(grid_t), target :: source, target, coarse
    type(scaler_t) :: scaler
    real(dp) :: result(1), up_result(1), down_result(3)
    integer(i4) :: ci, cj, xl, xu, yl, yu

    call source%init(3_i4, 1_i4, cellsize=1.0_dp)
    call target%init(3_i4, 1_i4, cellsize=1.0_dp, mask=reshape([.false., .true., .false.], [3,1]))
    call scaler%init(source, target, cache_bounds=.true.)
    @assertEqual(scaler%scaling_mode, no_scaling)
    @assertTrue(associated(scaler%source_grid, source))
    @assertTrue(associated(scaler%target_grid, target))
    @assertTrue(associated(scaler%fine_grid, target))
    @assertTrue(associated(scaler%coarse_grid, source))
    @assertFalse(scaler%cache_bounds)
    @assertEqual(scaler%weight_mode, weight_count)
    @assertEqual(scaler%id_map, [2_i8])
    @assertEqual(scaler%n_subcells, [0_i4, 1_i4, 0_i4])
    call scaler%execute([10.0_dp, 20.0_dp, 30.0_dp], result)
    @assertEqual(result, [20.0_dp], tolerance=0.0_dp)
    call scaler%coarse_ij(1_i8, ci, cj)
    @assertEqual([ci,cj], [2_i4,1_i4])
    call scaler%coarse_bounds(2_i8, xl, xu, yl, yu)
    @assertEqual([xl,xu,yl,yu], [2_i4,2_i4,1_i4,1_i4])

    ! Reuse one scaler through modes with different owned weights and map lengths.
    call coarse%init(1_i4, 1_i4, cellsize=3.0_dp)
    call scaler%init(source, coarse, weight_mode=weight_area)
    call scaler%execute([10.0_dp, 20.0_dp, 30.0_dp], up_result)
    @assertEqual(up_result, [20.0_dp], tolerance=1.e-12_dp)
    call scaler%init(coarse, source)
    call scaler%execute([9.0_dp], down_result, downscaling_operator=down_split)
    @assertEqual(down_result, [3.0_dp,3.0_dp,3.0_dp], tolerance=1.e-12_dp)
    call scaler%init(source, target, fill_missing=.true.)
    @assertEqual(scaler%id_map, [2_i8])
    @assertEqual(scaler%n_subcells, [0_i4,1_i4,0_i4])
    call scaler%destroy()
    call scaler%destroy()
    @assertFalse(associated(scaler%fine_grid))
    @assertFalse(associated(scaler%coarse_grid))
    @assertFalse(allocated(scaler%id_map))
    @assertFalse(allocated(scaler%n_subcells))
    @assertEqual(source%ncells, 3_i8)
    @assertEqual(target%ncells, 1_i8)
    call scaler%init(source, target)
    call scaler%execute([10_i4,20_i4,30_i4], result)
    @assertEqual(result, [20.0_dp], tolerance=0.0_dp)

    call target%init(3_i4, 1_i4, cellsize=1.0_dp, mask=reshape([.false.,.false.,.false.], [3,1]))
    call scaler%init(source, target, fill_missing=.true.)
    @assertEqual(size(scaler%id_map), 0)
    @assertEqual(scaler%n_subcells, [0_i4,0_i4,0_i4])
    call scaler%execute([10.0_dp,20.0_dp,30.0_dp], result(1:0))
  end subroutine test_equal_target_contract

  @test
  subroutine test_equal_geometry_contract()
    type(grid_t), target :: source, target
    type(scaler_t) :: scaler
    logical :: smask(5,4), tmask(4,3)
    integer(i8) :: source_ids(5,4), expected_ids(12), ks, kt, k
    integer(i4) :: counts(20), sd, td, shift, i, j, jg, si, sj, ci, cj, xl, xu, yl, yu, ti, tj
    real(dp) :: values(5,4), expected(12), result(12)

    do sd = top_down, bottom_up
      do td = top_down, bottom_up
        do shift = -1_i4, 1_i4, 2_i4
          ks = 0_i8
          source_ids = nodata_i8
          do j = 1_i4, 4_i4
            jg = merge(j, 5_i4-j, sd == bottom_up)
            do i = 1_i4, 5_i4
              values(i,j) = real(i+10_i4*jg,dp)
              smask(i,j) = modulo(i+2_i4*jg,4_i4) /= 0_i4
              if (.not. smask(i,j)) cycle
              ks = ks + 1_i8
              source_ids(i,j) = ks
            end do
          end do
          kt = 0_i8
          tmask = .false.
          counts = 0_i4
          do j = 1_i4, 3_i4
            jg = merge(j, 4_i4-j, td == bottom_up)
            do i = 1_i4, 4_i4
              si = i + shift
              sj = jg + shift
              if (si < 1_i4 .or. si > 5_i4 .or. sj < 1_i4 .or. sj > 4_i4) cycle
              if (sd == top_down) sj = 5_i4-sj
              if (.not. smask(si,sj)) cycle
              if (modulo(si+jg+shift,3_i4) == 0_i4) cycle
              tmask(i,j) = .true.
              kt = kt + 1_i8
              expected_ids(kt) = source_ids(si,sj)
              expected(kt) = values(si,sj)
              counts(source_ids(si,sj)) = counts(source_ids(si,sj)) + 1_i4
            end do
          end do
          call source%init(5_i4,4_i4,cellsize=1.0_dp,mask=smask,y_direction=sd)
          call target%init(4_i4,3_i4,cellsize=1.0_dp,mask=tmask,y_direction=td, &
            xllcorner=real(shift,dp),yllcorner=real(shift,dp))
          call scaler%init(source,target)
          @assertEqual(scaler%offset, [-shift,-shift])
          @assertEqual(scaler%id_map, expected_ids(:kt))
          @assertEqual(scaler%n_subcells, counts(:ks))
          call scaler%execute(values,result(:kt))
          @assertEqual(result(:kt), expected(:kt), tolerance=0.0_dp)
          do k = 1_i8, kt
            call scaler%coarse_ij(k,ci,cj)
            @assertEqual(source_ids(ci,cj), expected_ids(k))
            call scaler%coarse_ij(target%cell_ij(k,1),target%cell_ij(k,2),ci,cj)
            @assertEqual(source_ids(ci,cj), expected_ids(k))
          end do
          do k = 1_i8, ks
            si = source%cell_ij(k,1)
            sj = source%cell_ij(k,2)
            ti = si-shift
            jg = merge(sj,5_i4-sj,sd == bottom_up)-shift
            tj = merge(jg,4_i4-jg,td == bottom_up)
            call scaler%coarse_bounds(k,xl,xu,yl,yu)
            if (ti < 1_i4 .or. ti > 4_i4 .or. tj < 1_i4 .or. tj > 3_i4) then
              @assertEqual([xl,xu,yl,yu], [1_i4,0_i4,1_i4,0_i4])
            else
              @assertEqual([xl,xu,yl,yu], [ti,ti,tj,tj])
            end if
            call scaler%coarse_bounds(si,sj,ci,xu,cj,yu)
            @assertEqual([ci,cj], [xl,yl])
          end do
        end do
      end do
    end do
  end subroutine test_equal_geometry_contract

  @test
  subroutine test_equal_representations()
    type(grid_t), target :: source, target
    type(scaler_t) :: scaler
    real(dp) :: values(8,6), packed(24), out(6), mat(4,4), expected(3), expected_mat(2,2)
    integer(i4) :: integers(8,6), ipacked(24), iout(6), imat(4,4), i, j
    logical :: smask(4,3), tmask(2,2)

    smask = .true.
    smask(1,1) = .false.
    smask(3,1) = .false.
    tmask = reshape([.true.,.false.,.true.,.true.],[2,2])
    call source%init(4_i4,3_i4,cellsize=1.0_dp,mask=smask,y_direction=bottom_up)
    call target%init(2_i4,2_i4,cellsize=1.0_dp,mask=tmask,y_direction=top_down,xllcorner=1.0_dp,yllcorner=1.0_dp)
    call scaler%init(source,target)
    values = -123.0_dp
    do j = 1_i4, 3_i4
      do i = 1_i4, 4_i4
        values(2*i-1,2*j-1) = real(i+10*j,dp)
      end do
    end do
    integers = int(values,i4)
    packed = -123.0_dp
    ipacked = -123_i4
    call source%pack_into(values(::2,::2),packed(1:2*source%ncells:2))
    call source%pack_into(integers(::2,::2),ipacked(1:2*source%ncells:2))
    expected = [32.0_dp,22.0_dp,23.0_dp]
    expected_mat = reshape([32.0_dp,nodata_dp,22.0_dp,23.0_dp],[2,2])
    call scaler%execute(values(::2,::2),out(::2))
    @assertEqual(out(::2), expected)
    call scaler%execute(values(::2,::2),mat(::2,::2))
    @assertEqual(mat(::2,::2), expected_mat)
    call scaler%execute(packed(1:2*source%ncells:2),out(::2))
    @assertEqual(out(::2), expected)
    call scaler%execute(packed(1:2*source%ncells:2),mat(::2,::2))
    @assertEqual(mat(::2,::2), expected_mat)
    call scaler%execute(integers(::2,::2),iout(::2))
    @assertEqual(iout(::2), int(expected,i4))
    call scaler%execute(integers(::2,::2),imat(::2,::2))
    @assertEqual(imat(::2,::2), reshape([32_i4,nodata_i4,22_i4,23_i4],[2,2]))
    call scaler%execute(ipacked(1:2*source%ncells:2),iout(::2))
    @assertEqual(iout(::2), int(expected,i4))
    call scaler%execute(ipacked(1:2*source%ncells:2),imat(::2,::2))
    @assertEqual(imat(::2,::2), reshape([32_i4,nodata_i4,22_i4,23_i4],[2,2]))
    call scaler%execute(integers(::2,::2),out(::2))
    @assertEqual(out(::2), expected)
    call scaler%execute(integers(::2,::2),mat(::2,::2))
    @assertEqual(mat(::2,::2), expected_mat)
    call scaler%execute(ipacked(1:2*source%ncells:2),out(::2))
    @assertEqual(out(::2), expected)
    call scaler%execute(ipacked(1:2*source%ncells:2),mat(::2,::2))
    @assertEqual(mat(::2,::2), expected_mat)
  end subroutine test_equal_representations

  @test
  subroutine test_equal_missing_representations()
    type(grid_t), target :: source, target
    type(scaler_t) :: scaler
    integer(i4) :: mode, idir, classes(1,4), ipacked(2), iout(3), imat(1,3)
    real(dp) :: values(1,4), packed(2), out(3), mat(1,3), expected(3)

    classes(:,1) = 999_i4
    classes(:,2) = 3_i4
    classes(:,3) = 7_i4
    classes(:,4) = 999_i4
    values = real(classes,dp)
    packed = [3.0_dp,7.0_dp]
    ipacked = [3_i4,7_i4]
    do mode = 0_i4, 1_i4
      do idir = top_down, bottom_up
        call source%init(1_i4,4_i4,cellsize=1.0_dp,y_direction=bottom_up, &
          mask=reshape([.false.,.true.,.true.,.false.],[1,4]))
        call target%init(1_i4,3_i4,cellsize=1.0_dp,y_direction=idir,yllcorner=1.0_dp)
        call scaler%init(source,target,fill_missing=.true.,use_index_distance=mode == 1_i4)
        expected = [3.0_dp,7.0_dp,7.0_dp]
        if (idir == top_down) expected = expected(3:1:-1)
        if (idir == bottom_up) then
          @assertEqual(scaler%id_map, [1_i8,2_i8,nodata_i8])
        else
          @assertEqual(scaler%id_map, [nodata_i8,2_i8,1_i8])
        end if
        @assertEqual(scaler%n_subcells, [1_i4,1_i4])
        @assertEqual(scaler%offset, [0_i4,-1_i4])
        call scaler%execute(values,out)
        @assertEqual(out, expected)
        call scaler%execute(values,mat)
        @assertEqual(mat, reshape(expected,[1,3]))
        call scaler%execute(packed,out)
        @assertEqual(out, expected)
        call scaler%execute(packed,mat)
        @assertEqual(mat, reshape(expected,[1,3]))
        call scaler%execute(classes,iout)
        @assertEqual(iout, int(expected,i4))
        call scaler%execute(classes,imat)
        @assertEqual(imat, reshape(int(expected,i4),[1,3]))
        call scaler%execute(ipacked,iout)
        @assertEqual(iout, int(expected,i4))
        call scaler%execute(ipacked,imat)
        @assertEqual(imat, reshape(int(expected,i4),[1,3]))
        call scaler%execute(classes,out)
        @assertEqual(out, expected)
        call scaler%execute(classes,mat)
        @assertEqual(mat, reshape(expected,[1,3]))
        call scaler%execute(ipacked,out)
        @assertEqual(out, expected)
        call scaler%execute(ipacked,mat)
        @assertEqual(mat, reshape(expected,[1,3]))
        expected = merge(1.0_dp,0.0_dp,expected == 7.0_dp)
        call scaler%execute(classes,out,upscaling_operator=up_fraction,class_id=7_i4)
        @assertEqual(out, expected)
        call scaler%execute(ipacked,mat,upscaling_operator=up_fraction,class_id=7_i4)
        @assertEqual(mat, reshape(expected,[1,3]))
        call scaler%execute(ipacked,out,upscaling_operator=up_fraction)
        @assertEqual(out, [0.0_dp,0.0_dp,0.0_dp])
        call scaler%execute(packed,out,upscaling_operator=up_var)
        @assertEqual(out, [0.0_dp,0.0_dp,0.0_dp])
        call scaler%execute(values,mat,upscaling_operator=up_std)
        @assertEqual(mat, reshape([0.0_dp,0.0_dp,0.0_dp],[1,3]))
        call scaler%execute(ipacked,out,upscaling_operator=up_std)
        @assertEqual(out, [0.0_dp,0.0_dp,0.0_dp])
        call scaler%execute(classes,mat,upscaling_operator=up_var)
        @assertEqual(mat, reshape([0.0_dp,0.0_dp,0.0_dp],[1,3]))
        call scaler%execute(ipacked,iout,upscaling_operator=up_var)
        @assertEqual(iout, int(merge([3.0_dp,7.0_dp,7.0_dp],[7.0_dp,7.0_dp,3.0_dp],idir == bottom_up),i4))
      end do
    end do
  end subroutine test_equal_missing_representations

  @test
  subroutine test_periodic_regional_scaling()
    type(grid_t), target :: source_grid, target_grid
    type(scaler_t) :: scaler
    integer(i4) :: sd, td, mode, cache, i, j, jg
    real(dp) :: source(12,2), expected(14,2)
    real(dp), allocatable :: result(:)
    logical :: padded_mask(14,2)

    do sd = top_down, bottom_up
      do td = top_down, bottom_up
        call source_grid%init(12_i4, 2_i4, yllcorner=-30.0_dp, cellsize=30.0_dp, &
                              coordsys=spherical, y_direction=sd)
        do j = 1_i4, 2_i4
          jg = merge(j, 3_i4-j, sd == bottom_up)
          do i = 1_i4, 12_i4
            source(i,j) = real(100_i4*jg+i, dp)
          end do
        end do
        do mode = 1_i4, 3_i4
          select case (mode)
          case (1_i4)
            call target_grid%init(3_i4, 2_i4, xllcorner=315.0_dp, yllcorner=-15.0_dp, &
                                  cellsize=15.0_dp, coordsys=spherical, y_direction=td)
            do j = 1_i4, 2_i4
              jg = merge(j, 3_i4-j, td == bottom_up)
              expected(1:3,j) = real(100_i4*jg, dp) + [11.0_dp,12.0_dp,12.0_dp]
            end do
          case (2_i4)
            call target_grid%init(2_i4, 2_i4, xllcorner=300.0_dp, yllcorner=-30.0_dp, &
                                  cellsize=30.0_dp, coordsys=spherical, y_direction=td)
            do j = 1_i4, 2_i4
              jg = merge(j, 3_i4-j, td == bottom_up)
              expected(1:2,j) = real(100_i4*jg, dp) + [11.0_dp,12.0_dp]
            end do
          case (3_i4)
            call target_grid%init(1_i4, 1_i4, xllcorner=300.0_dp, yllcorner=-30.0_dp, &
                                  cellsize=60.0_dp, coordsys=spherical, y_direction=td)
            expected(1,1) = 161.5_dp
          end select
          @assertTrue(source_grid%is_periodic())
          @assertFalse(target_grid%is_periodic())
          allocate(result(target_grid%ncells))
          do cache = 0_i4, 1_i4
            call scaler%init(source_grid, target_grid, cache_bounds=cache == 1_i4)
            call scaler%execute(source, result)
            @assertEqual(result, target_grid%pack(expected(1:target_grid%nx,1:target_grid%ny)), tolerance=1.e-12_dp)
            call scaler%execute(source_grid%pack(source), result)
            @assertEqual(result, target_grid%pack(expected(1:target_grid%nx,1:target_grid%ny)), tolerance=1.e-12_dp)
          end do
          call scaler%destroy()
          deallocate(result)
        end do

        call target_grid%init(6_i4, 1_i4, yllcorner=-30.0_dp, cellsize=60.0_dp, &
                              coordsys=spherical, y_direction=td)
        allocate(result(target_grid%ncells))
        call scaler%init(source_grid, target_grid)
        call scaler%execute(source, result)
        @assertEqual(result, [151.5_dp,153.5_dp,155.5_dp,157.5_dp,159.5_dp,161.5_dp], tolerance=1.e-12_dp)
        call scaler%destroy()
        deallocate(result)

        ! Inactive padding does not require source support or seam wrapping.
        padded_mask = .true.
        padded_mask(1,:) = .false.
        padded_mask(14,:) = .false.
        call target_grid%init(14_i4, 2_i4, xllcorner=-30.0_dp, yllcorner=-30.0_dp, &
                              cellsize=30.0_dp, coordsys=spherical, mask=padded_mask, y_direction=td)
        do j = 1_i4, 2_i4
          jg = merge(j, 3_i4-j, td == bottom_up)
          do i = 2_i4, 13_i4
            expected(i,j) = real(100_i4*jg+i-1_i4, dp)
          end do
        end do
        allocate(result(target_grid%ncells))
        call scaler%init(source_grid, target_grid)
        call scaler%execute(source, result)
        @assertEqual(result, target_grid%pack(expected), tolerance=1.e-12_dp)
        call scaler%destroy()
        deallocate(result)
        call target_grid%init(1_i4, 1_i4, xllcorner=390.0_dp, cellsize=30.0_dp, &
                              coordsys=spherical, mask=reshape([.false.],[1,1]))
        call scaler%init(source_grid, target_grid)
        @assertEqual(target_grid%ncells, 0_i8, message='empty regional targets need no longitude support')
        call scaler%destroy()
      end do
    end do
  end subroutine test_periodic_regional_scaling

  @test
  subroutine test_offset_meteo_downscaling()
    type(grid_t), target :: coarse, fine
    type(scaler_t) :: scaler
    real(dp) :: source(6,5), expected(3,3), result(3,3), packed(9), split(9)
    integer(i4) :: integers(3,3), fd, cd, cache, i, j, jg, xl, xu, yl, yu

    do cd = top_down, bottom_up
      do fd = top_down, bottom_up
        call coarse%init(6_i4, 5_i4, cellsize=4.0_dp, y_direction=cd)
        call fine%init(3_i4, 3_i4, xllcorner=9.0_dp, yllcorner=7.0_dp, cellsize=1.0_dp, y_direction=fd)
        do j = 1_i4, 5_i4
          jg = merge(j, 6_i4-j, cd == bottom_up)
          do i = 1_i4, 6_i4
            source(i,j) = real(100_i4*jg+i, dp)
          end do
        end do
        do j = 1_i4, 3_i4
          jg = merge(j, 4_i4-j, fd == bottom_up)
          expected(:,j) = merge(203.0_dp, 303.0_dp, jg == 1_i4)
        end do
        do cache = 0_i4, 1_i4
          call scaler%init(coarse, fine, cache_bounds=cache == 1_i4)
          @assertEqual(scaler%offset, [-9_i4, -7_i4])
          call scaler%execute(source, result)
          @assertEqual(result, expected, tolerance=1.e-12_dp)
          call scaler%execute(coarse%pack(source), packed)
          @assertEqual(packed, fine%pack(expected), tolerance=1.e-12_dp)
          call scaler%execute(int(source,i4), integers)
          @assertEqual(integers, int(expected,i4))
          call scaler%execute(coarse%pack(int(source,i4)), result)
          @assertEqual(result, expected, tolerance=1.e-12_dp)
          call scaler%coarse_bounds(1_i4, 1_i4, xl, xu, yl, yu)
          @assertEqual([xl, xu, yl, yu], [1_i4, 0_i4, 1_i4, 0_i4])
          call scaler%execute(coarse%pack(source), split, downscaling_operator=down_split)
          @assertEqual(sum(split), 506.0_dp, tolerance=1.e-12_dp)
          do j = 1_i4, 3_i4
            jg = merge(j, 4_i4-j, fd == bottom_up)
            result(:,j) = expected(:,j) / merge(3.0_dp, 6.0_dp, jg == 1_i4)
          end do
          @assertEqual(split, fine%pack(result), tolerance=1.e-12_dp)
        end do
        call scaler%destroy()
        @assertEqual(scaler%offset, [0_i4, 0_i4])
      end do
    end do
  end subroutine test_offset_meteo_downscaling

  @test
  subroutine test_offset_upscaling()
    type(grid_t), target :: fine, coarse
    type(scaler_t) :: scaler
    real(dp) :: source(6,4), weights(6,4), out(2)
    logical :: mask(6,4)
    integer(i4) :: d, i, j, jg, cache
    integer(i8) :: loc(2), expected_loc(2)

    do d = top_down, bottom_up
      call fine%init(6_i4, 4_i4, cellsize=1.0_dp, y_direction=d)
      call coarse%init(2_i4, 1_i4, xllcorner=1.0_dp, yllcorner=1.0_dp, cellsize=2.0_dp)
      weights = 1.0_dp
      do j = 1_i4, 4_i4
        jg = merge(j, 5_i4-j, d == bottom_up)
        do i = 1_i4, 6_i4
          source(i,j) = real(i+10_i4*jg, dp)
        end do
        if (jg == 2_i4) weights(2,j) = 3.0_dp
      end do
      fine%cell_area = fine%pack(weights)
      do cache = 0_i4, 1_i4
        call scaler%init(fine, coarse, weight_mode=weight_count, cache_bounds=cache == 1_i4)
        @assertEqual(scaler%offset, [1_i4, 1_i4])
        @assertTrue(scaler%id_map(1) < 1_i8, message='source cells outside the target are unmapped')
        call scaler%execute(source, out)
        @assertEqual(out, [27.5_dp, 29.5_dp], tolerance=1.e-12_dp)
        call scaler%execute(fine%pack(source), out, upscaling_operator=up_sum)
        @assertEqual(out, [110.0_dp, 118.0_dp], tolerance=1.e-12_dp)
        call scaler%execute(source, out, upscaling_operator=up_var)
        @assertEqual(out, [25.25_dp, 25.25_dp], tolerance=1.e-12_dp)
        call scaler%execute(int(source,i4), out, upscaling_operator=up_median)
        @assertEqual(out, [27.5_dp, 29.5_dp], tolerance=1.e-12_dp)
        call scaler%maxloc(source, loc)
        expected_loc = [fine%cell_id([3_i4, merge(3_i4, 2_i4, d == bottom_up)]), &
                        fine%cell_id([5_i4, merge(3_i4, 2_i4, d == bottom_up)])]
        @assertEqual(loc, expected_loc)
        call scaler%init(fine, coarse, weight_mode=weight_area, cache_bounds=cache == 1_i4)
        call scaler%execute(source, out)
        @assertEqual(out, [154.0_dp/6.0_dp, 29.5_dp], tolerance=1.e-12_dp)
      end do
      mask = .true.
      mask(4:5,:) = .false.
      call fine%init(6_i4, 4_i4, cellsize=1.0_dp, mask=mask, y_direction=d)
      call scaler%init(fine, coarse, fill_missing=.true., weight_mode=weight_count)
      call scaler%execute(fine%pack(source), out)
      @assertEqual(out, [27.5_dp, 27.5_dp], tolerance=1.e-12_dp)
    end do
  end subroutine test_offset_upscaling

  @test
  subroutine test_derived_rectangle_scaling()
    type(grid_t), target :: source_grid, target_grid
    type(scaler_t) :: scaler
    integer(i4) :: direction, mode, i, j, jg, si, sj
    integer(i8) :: k
    real(dp) :: source(2,2), resolution
    real(dp), allocatable :: result(:), expected(:)
    logical :: mask(2,2)

    do direction = top_down, bottom_up
      mask = .true.
      mask(2,merge(1_i4,2_i4,direction == bottom_up)) = .false.
      call source_grid%init(2_i4,2_i4,cellsize=2.0_dp,mask=mask,y_direction=direction)
      do j = 1_i4, 2_i4
        jg = merge(j,3_i4-j,direction == bottom_up)
        do i = 1_i4, 2_i4
          source(i,j) = real(10_i4*jg+i,dp)
        end do
      end do
      do mode = 1_i4, 3_i4
        resolution = real(2_i4 ** (mode-1_i4),dp)
        call source_grid%gen_grid(target_grid,target_resolution=resolution, &
          llcorner=[-4.0_dp,-4.0_dp],dims=[12_i4,12_i4],estimate_aux=.false.)
        allocate(result(target_grid%ncells),expected(target_grid%ncells))
        do k = 1_i8, target_grid%ncells
          if (mode == 3_i4) then
            expected(k) = 18.0_dp
          else
            si = int(target_grid%x_center(target_grid%cell_ij(k,1))/2.0_dp,i4) + 1_i4
            sj = int(target_grid%y_center(target_grid%cell_ij(k,2))/2.0_dp,i4) + 1_i4
            expected(k) = real(10_i4*sj+si,dp)
          end if
        end do
        call scaler%init(source_grid,target_grid)
        call scaler%execute(source,result)
        @assertEqual(result, expected, tolerance=1.e-12_dp)
        call scaler%execute(source_grid%pack(source),result)
        @assertEqual(result, expected, tolerance=1.e-12_dp)
        call scaler%destroy()
        deallocate(result,expected)
      end do
    end do
  end subroutine test_derived_rectangle_scaling

  @test
  subroutine test_offset_equal_resolution()
    type(grid_t), target :: source_grid, target_grid
    type(scaler_t) :: scaler
    real(dp) :: source(5,4), expected(2,2), result(2,2), packed(4)
    integer(i4) :: integers(2,2), sd, td, i, j, jg

    do sd = top_down, bottom_up
      do td = top_down, bottom_up
        call source_grid%init(5_i4, 4_i4, cellsize=1.0_dp, y_direction=sd)
        call target_grid%init(2_i4, 2_i4, xllcorner=2.0_dp, yllcorner=1.0_dp, cellsize=1.0_dp, y_direction=td)
        do j = 1_i4, 4_i4
          jg = merge(j, 5_i4-j, sd == bottom_up)
          do i = 1_i4, 5_i4
            source(i,j) = real(i+10_i4*jg, dp)
          end do
        end do
        do j = 1_i4, 2_i4
          jg = merge(j, 3_i4-j, td == bottom_up) + 1_i4
          expected(:,j) = real([3_i4, 4_i4] + 10_i4*jg, dp)
        end do
        call scaler%init(source_grid, target_grid)
        call scaler%execute(source, result)
        @assertEqual(result, expected, tolerance=1.e-12_dp)
        call scaler%execute(source_grid%pack(source), packed)
        @assertEqual(packed, target_grid%pack(expected), tolerance=1.e-12_dp)
        call scaler%execute(int(source,i4), integers)
        @assertEqual(integers, int(expected,i4))
        call scaler%execute(source_grid%pack(int(source,i4)), result)
        @assertEqual(result, expected, tolerance=1.e-12_dp)
        call scaler%execute(int(source,i4), result, upscaling_operator=up_fraction, class_id=23_i4)
        @assertEqual(result, merge(1.0_dp, 0.0_dp, int(expected,i4) == 23_i4), tolerance=1.e-12_dp)
        call scaler%execute(source, packed, upscaling_operator=up_var)
        @assertEqual(packed, [0.0_dp, 0.0_dp, 0.0_dp, 0.0_dp], tolerance=1.e-12_dp)
      end do
    end do
    call scaler%init(source_grid, source_grid)
    @assertEqual(scaler%offset, [0_i4, 0_i4], message='reinitialization clears the previous offset')
  end subroutine test_offset_equal_resolution

  @test
  subroutine test_offset_masked_downscaling()
    type(grid_t), target :: coarse, fine
    type(scaler_t) :: scaler
    real(dp) :: out(2)
    logical, allocatable :: missing(:,:)

    call coarse%init(3_i4, 1_i4, cellsize=2.0_dp, mask=reshape([.true., .false., .false.], [3,1]))
    call fine%init(2_i4, 1_i4, xllcorner=2.0_dp, cellsize=1.0_dp)
    call fine%uncovered_mask(coarse, missing)
    @assertTrue(all(missing))
    call scaler%init(coarse, fine, fill_missing=.true.)
    call scaler%execute([10.0_dp], out)
    @assertEqual(out, [10.0_dp, 10.0_dp], tolerance=1.e-12_dp)
    call scaler%execute([10.0_dp], out, downscaling_operator=down_split)
    @assertEqual(out, [5.0_dp, 5.0_dp], tolerance=1.e-12_dp)
    call fine%init(2_i4, 1_i4, xllcorner=2.0_dp, cellsize=1.0_dp, mask=reshape([.true., .false.], [2,1]))
    call scaler%init(coarse, fine, fill_missing=.true.)
    call scaler%execute([10.0_dp], out(1:1), downscaling_operator=down_split)
    @assertEqual(out(1), 10.0_dp, tolerance=1.e-12_dp, message='split counts participating active fine cells')

    call coarse%init(3_i4, 1_i4, cellsize=2.0_dp)
    call fine%init(3_i4, 1_i4, xllcorner=-1.0_dp, cellsize=1.0_dp, &
                   mask=reshape([.false., .true., .true.], [3,1]))
    call scaler%init(coarse, fine)
    call scaler%execute([10.0_dp, 20.0_dp, 30.0_dp], out)
    @assertEqual(out, [10.0_dp, 10.0_dp], tolerance=1.e-12_dp, message='inactive target borders need no coverage')
  end subroutine test_offset_masked_downscaling


  @test
  subroutine test_regrid()

    implicit none
    type(grid_t), target :: cgrid, fgrid
    type(scaler_t) :: upscaler
    ! type(NcDataset) :: nc
    ! type(NcDimension) :: x_dim, y_dim
    ! type(NcVariable) :: var
    real(dp) :: t=1.0E-5_dp
    real(dp) :: ref_val
    integer(i4) :: xt, xb, yt, yb
    integer(i8) :: i
    real(dp), allocatable :: dem(:), dem_mat(:,:), cdem(:), cdem_mat(:,:)
    integer(i4), allocatable :: lc(:), clc(:), lc_mat(:,:), clc_mat(:,:)
    real(dp), allocatable :: lc1(:), lc2(:), lc3(:), lcf_mat(:,:)

    call fgrid%from_ascii_file("./files/dem.asc")
    cgrid = fgrid%derive_grid(upscaling_factor=16)

    call upscaler%init(fgrid, cgrid)

    call fgrid%read_data("./files/dem.asc", dem_mat)
    call fgrid%read_data("./files/landcover.asc", lc_mat)

    ! nc = NcDataset("dem.nc", "w")
    ! call fgrid%to_netcdf(nc)
    ! x_dim = nc%getDimension("x")
    ! y_dim = nc%getDimension("y")
    ! var = nc%setVariable("dem", "f64", [x_dim, y_dim])
    ! call var%setFillValue(nodata_dp)
    ! call var%setAttribute("missing_value", nodata_dp)
    ! call var%setData(dem_mat)
    ! call nc%close()

    allocate(dem(fgrid%ncells))
    dem = fgrid%pack(dem_mat)
    allocate(cdem(cgrid%ncells))
    allocate(cdem_mat(cgrid%nx, cgrid%ny))

    ! nc = NcDataset("cdem.nc", "w")
    ! call cgrid%to_netcdf(nc)
    ! x_dim = nc%getDimension("x")
    ! y_dim = nc%getDimension("y")

    @assertEqual(cgrid%nx, 18, message='upscaling nx check')
    @assertEqual(cgrid%ny, 27, message='upscaling ny check')

    call upscaler%execute(dem, cdem)
    ! check arithmetic mean upscaling
    do i = 1_i8, cgrid%ncells
      call upscaler%coarse_bounds(i, xb, xt, yb, yt)
      ! cartesian grid can use n-subcells for weights
      ref_val = sum(pack(dem_mat(xb:xt,yb:yt), fgrid%mask(xb:xt,yb:yt))) / upscaler%n_subcells(i)
      @assertEqual(cdem(i), ref_val, tolerance=t, message='upscaling arithmetic mean check')
    end do

    ! var = nc%setVariable("dem_mean", "f64", [x_dim, y_dim])
    ! call var%setFillValue(nodata_dp)
    ! call var%setAttribute("missing_value", nodata_dp)
    ! cdem_mat = cgrid%unpack(cdem)
    ! call var%setData(cdem_mat)

    call upscaler%execute(dem, cdem, upscaling_operator=up_p_mean, p=2.1_dp)
    ! check p-mean upscaling
    do i = 1_i8, cgrid%ncells
      call upscaler%coarse_bounds(i, xb, xt, yb, yt)
      ! cartesian grid can use n-subcells for weights
      ref_val = (sum(pack(dem_mat(xb:xt,yb:yt), fgrid%mask(xb:xt,yb:yt)) ** 2.1_dp) / upscaler%n_subcells(i)) ** (1.0_dp / 2.1_dp)
      @assertEqual(cdem(i), ref_val, tolerance=t, message='upscaling p-mean check (p=2.1)')
    end do

    ! var = nc%setVariable("dem_pmean", "f64", [x_dim, y_dim])
    ! call var%setFillValue(nodata_dp)
    ! call var%setAttribute("missing_value", nodata_dp)
    ! cdem_mat = cgrid%unpack(cdem)
    ! call var%setData(cdem_mat)

    call upscaler%execute(dem, cdem, upscaling_operator=up_p_mean, p=0.0_dp)
    ! check g-mean upscaling
    do i = 1_i8, cgrid%ncells
      call upscaler%coarse_bounds(i, xb, xt, yb, yt)
      ! cartesian grid can use n-subcells for weights
      ref_val = exp(sum(log(pack(dem_mat(xb:xt,yb:yt), fgrid%mask(xb:xt,yb:yt)))) / upscaler%n_subcells(i))
      @assertEqual(cdem(i), ref_val, tolerance=t, message='upscaling geometric mean check')
    end do

    ! var = nc%setVariable("dem_gmean", "f64", [x_dim, y_dim])
    ! call var%setFillValue(nodata_dp)
    ! call var%setAttribute("missing_value", nodata_dp)
    ! cdem_mat = cgrid%unpack(cdem)
    ! call var%setData(cdem_mat)

    call upscaler%execute(dem, cdem, upscaling_operator=up_h_mean)
    ! check h-mean upscaling
    do i = 1_i8, cgrid%ncells
      call upscaler%coarse_bounds(i, xb, xt, yb, yt)
      ! cartesian grid can use n-subcells for weights
      ref_val = 1.0_dp / (sum(1.0 / pack(dem_mat(xb:xt,yb:yt), fgrid%mask(xb:xt,yb:yt))) / upscaler%n_subcells(i))
      @assertEqual(cdem(i), ref_val, tolerance=t, message='upscaling harmonic mean check')
    end do

    ! var = nc%setVariable("dem_hmean", "f64", [x_dim, y_dim])
    ! call var%setFillValue(nodata_dp)
    ! call var%setAttribute("missing_value", nodata_dp)
    ! cdem_mat = cgrid%unpack(cdem)
    ! call var%setData(cdem_mat)

    call upscaler%execute(dem, cdem, upscaling_operator=up_min)
    ! check min upscaling
    do i = 1_i8, cgrid%ncells
      call upscaler%coarse_bounds(i, xb, xt, yb, yt)
      ! cartesian grid can use n-subcells for weights
      ref_val = minval(dem_mat(xb:xt,yb:yt), mask=fgrid%mask(xb:xt,yb:yt))
      @assertEqual(cdem(i), ref_val, tolerance=t, message='upscaling min check')
    end do

    ! var = nc%setVariable("dem_min", "f64", [x_dim, y_dim])
    ! call var%setFillValue(nodata_dp)
    ! call var%setAttribute("missing_value", nodata_dp)
    ! cdem_mat = cgrid%unpack(cdem)
    ! call var%setData(cdem_mat)

    call upscaler%execute(dem, cdem, upscaling_operator=up_max)
    ! check max upscaling
    do i = 1_i8, cgrid%ncells
      call upscaler%coarse_bounds(i, xb, xt, yb, yt)
      ! cartesian grid can use n-subcells for weights
      ref_val = maxval(dem_mat(xb:xt,yb:yt), mask=fgrid%mask(xb:xt,yb:yt))
      @assertEqual(cdem(i), ref_val, tolerance=t, message='upscaling max check')
    end do

    ! var = nc%setVariable("dem_max", "f64", [x_dim, y_dim])
    ! call var%setFillValue(nodata_dp)
    ! call var%setAttribute("missing_value", nodata_dp)
    ! cdem_mat = cgrid%unpack(cdem)
    ! call var%setData(cdem_mat)

    allocate(lc(fgrid%ncells))
    lc = fgrid%pack(lc_mat)
    allocate(clc(cgrid%ncells))
    allocate(lc1(cgrid%ncells))
    allocate(lc2(cgrid%ncells))
    allocate(lc3(cgrid%ncells))
    call upscaler%execute(lc, clc, upscaling_operator=up_laf, vmin=1_i4, vmax=3_i4)
    call upscaler%execute(lc, lc1, upscaling_operator=up_fraction, class_id=1_i4)
    call upscaler%execute(lc, lc2, upscaling_operator=up_fraction, class_id=2_i4)
    call upscaler%execute(lc, lc3, upscaling_operator=up_fraction, class_id=3_i4)

    @assertTrue(all(is_close(lc1+lc2+lc3, 1.0_dp)), message='check fractions sum to 1')
    @assertEqual(count(clc==1)+count(clc==2)+count(clc==3), cgrid%ncells, message='check fraction counts')

    ! call nc%close()

  end subroutine test_regrid

  @test
  subroutine test_downscale_modes()
    implicit none
    type(grid_t), target :: coarse, fine
    type(scaler_t) :: scaler
    real(dp), allocatable :: dp_out(:)
    integer(i4), allocatable :: i_out(:)
    real(dp) :: dp_in(2), dp_in_mat(2,1)
    integer(i4) :: i_in(2)
    integer(i4) :: xl, xu, yl, yu

    call coarse%init(nx=2, ny=1, cellsize=2.0_dp, coordsys=cartesian, y_direction=bottom_up)
    call fine%init(nx=4, ny=1, cellsize=1.0_dp, coordsys=cartesian, y_direction=bottom_up)
    call scaler%init(coarse, fine, downscaling_operator=down_split)

    dp_in = [2.0_dp, 6.0_dp]
    dp_in_mat = reshape(dp_in, [2,1])
    i_in = [1_i4, 3_i4]
    allocate(dp_out(fine%ncells), i_out(fine%ncells))

    call scaler%downscale_nearest(dp_in, dp_out)
    @assertEqual(dp_out, [2.0_dp, 2.0_dp, 6.0_dp, 6.0_dp], tolerance=1.0e-12_dp)

    call scaler%execute(dp_in, dp_out, downscaling_operator=down_nearest)
    @assertEqual(dp_out, [2.0_dp, 2.0_dp, 6.0_dp, 6.0_dp], tolerance=1.0e-12_dp)

    call scaler%execute(dp_in, dp_out, downscaling_operator=down_split)
    @assertEqual(dp_out, [1.0_dp, 1.0_dp, 3.0_dp, 3.0_dp], tolerance=1.0e-12_dp)

    call scaler%downscale_nearest(dp_in_mat, dp_out)
    @assertEqual(dp_out(2), 2.0_dp, tolerance=1.0e-12_dp)

    call scaler%downscale_nearest(i_in, i_out)
    @assertEqual(i_out, [1_i4, 1_i4, 3_i4, 3_i4])

    call scaler%execute(i_in, i_out, downscaling_operator=down_nearest)
    @assertEqual(i_out, [1_i4, 1_i4, 3_i4, 3_i4])

    call scaler%coarse_bounds(coarse_i=1, coarse_j=1, x_lb=xl, x_ub=xu, y_lb=yl, y_ub=yu)
    @assertEqual([xl, xu, yl, yu], [1_i4, 2_i4, 1_i4, 1_i4])

    call scaler%downscale_split(dp_in_mat, dp_out)
    @assertEqual(dp_out(1:2), [1.0_dp, 1.0_dp], tolerance=1.0e-12_dp)

    call scaler%downscale_split(dp_in, dp_out)
    @assertEqual(dp_out(1), 1.0_dp, tolerance=1.0e-12_dp)

    call scaler%init(coarse, fine, downscaling_operator=down_split, weight_mode=weight_count)
    call scaler%execute(dp_in, dp_out, downscaling_operator=down_split)
    @assertEqual(dp_out, [1.0_dp, 1.0_dp, 3.0_dp, 3.0_dp], tolerance=1.0e-12_dp, message='down_split stays equal for count weighting')
  end subroutine test_downscale_modes

  @test
  subroutine test_no_scaling_identity()
    implicit none
    type(grid_t), target :: g1, g2
    type(scaler_t) :: scaler
    real(dp) :: data_mat(2,2)
    real(dp), allocatable :: packed_in(:), packed_out(:), unpacked(:,:)

    call g1%init(nx=2, ny=2, cellsize=1.0_dp, coordsys=cartesian, y_direction=bottom_up)
    call g2%init(nx=2, ny=2, cellsize=1.0_dp, coordsys=cartesian, y_direction=bottom_up)
    call scaler%init(g1, g2)

    data_mat = reshape([1.0_dp, 2.0_dp, 3.0_dp, 4.0_dp], [2,2])
    packed_in = g1%pack(data_mat)
    allocate(packed_out(size(packed_in)))
    call scaler%execute(packed_in, packed_out)
    allocate(unpacked(2,2))
    call g2%unpack_into(packed_out, unpacked)

    @assertEqual(unpacked, data_mat, tolerance=1.0e-12_dp)
  end subroutine test_no_scaling_identity

  @test
  subroutine test_no_scaling_operators()
    implicit none
    type(grid_t), target :: source, target
    type(scaler_t) :: scaler
    integer(i4) :: classes(2,2)
    real(dp) :: values(2,2), expected(4), expected_mat(2,2)
    integer(i4), allocatable :: packed_classes(:)
    real(dp), allocatable :: out(:), out_mat(:,:)

    call source%init(nx=2, ny=2, cellsize=1.0_dp, coordsys=cartesian, y_direction=bottom_up)
    call target%init(nx=2, ny=2, cellsize=1.0_dp, coordsys=cartesian, y_direction=top_down)
    call scaler%init(source, target, upscaling_operator=up_fraction)

    classes = reshape([3_i4, 1_i4, 2_i4, 3_i4], [2,2])
    allocate(out(target%ncells))
    call scaler%execute(classes, out, class_id=3_i4)
    expected = [0.0_dp, 1.0_dp, 1.0_dp, 0.0_dp]
    @assertEqual(out, expected, tolerance=1.0e-12_dp, message='no-scale fraction is binary and flipped')

    call scaler%execute(classes, out, class_id=4_i4)
    expected = 0.0_dp
    @assertEqual(out, expected, tolerance=1.0e-12_dp, message='no-scale fraction is zero for nonmatches')

    packed_classes = source%pack(classes)
    allocate(out_mat(target%nx, target%ny))
    call scaler%execute(packed_classes, out_mat, class_id=3_i4)
    expected = [0.0_dp, 1.0_dp, 1.0_dp, 0.0_dp]
    expected_mat = reshape(expected, [2,2])
    @assertEqual(out_mat, expected_mat, tolerance=1.0e-12_dp, message='packed no-scale fraction is binary')

    values = reshape([1.0_dp, 2.0_dp, 3.0_dp, 4.0_dp], [2,2])
    expected = 0.0_dp
    expected_mat = 0.0_dp
    call scaler%execute(values, out, upscaling_operator=up_var)
    @assertEqual(out, expected, tolerance=1.0e-12_dp, message='no-scale real variance is zero')
    call scaler%execute(values, out, upscaling_operator=up_std)
    @assertEqual(out, expected, tolerance=1.0e-12_dp, message='no-scale real standard deviation is zero')
    call scaler%execute(classes, out, upscaling_operator=up_var)
    @assertEqual(out, expected, tolerance=1.0e-12_dp, message='no-scale integer variance is zero as real')
    call scaler%execute(packed_classes, out_mat, upscaling_operator=up_std)
    @assertEqual(out_mat, expected_mat, tolerance=1.0e-12_dp, message='packed no-scale integer standard deviation is zero')
  end subroutine test_no_scaling_operators

  @test
  subroutine test_stats_and_weight_count()
    implicit none
    type(grid_t), target :: fine, coarse
    type(scaler_t) :: scaler
    real(dp) :: data(2,2)
    integer(i4) :: idata(2,2)
    real(dp), allocatable :: out(:), out_mat(:,:)
    real(dp), allocatable :: out_mat2(:,:)
    integer(i4), allocatable :: iout(:), i_mat(:,:)
    integer(i4) :: ci, cj
    real(dp), allocatable :: packed_dp(:)
    integer(i4), allocatable :: packed_i(:)
    integer(i8), allocatable :: loc_ids(:)

    call fine%init(nx=2, ny=2, cellsize=1.0_dp, coordsys=cartesian, y_direction=bottom_up)
    call coarse%init(nx=1, ny=1, cellsize=2.0_dp, coordsys=cartesian, y_direction=bottom_up)
    call scaler%init(fine, coarse, weight_mode=weight_count)

    data = reshape([1.0_dp, 2.0_dp, 3.0_dp, 4.0_dp], [2,2])
    idata = reshape([1_i4, 2_i4, 3_i4, 4_i4], [2,2])
    allocate(out(coarse%ncells))

    call scaler%execute(data, out, upscaling_operator=7_i4) ! up_var
    @assertEqual(out(1), 1.25_dp, tolerance=1.0e-12_dp)

    call scaler%execute(data, out, upscaling_operator=8_i4) ! up_std
    @assertEqual(out(1), sqrt(1.25_dp), tolerance=1.0e-12_dp)

    call scaler%execute(data, out, upscaling_operator=up_median)
    @assertEqual(out(1), 2.5_dp, tolerance=1.0e-12_dp)

    allocate(iout(coarse%ncells))
    call scaler%execute(idata, iout, upscaling_operator=up_min)
    @assertEqual(iout(1), 1_i4)
    call scaler%execute(idata, iout, upscaling_operator=up_max)
    @assertEqual(iout(1), 4_i4)
    call scaler%execute(idata, iout, upscaling_operator=up_sum)
    @assertEqual(10.0_dp, real(iout(1), dp), tolerance=1.0e-12_dp)

    allocate(out_mat(coarse%nx, coarse%ny))
    call scaler%execute(idata, out_mat, upscaling_operator=up_a_mean)
    @assertEqual(2.5_dp, out_mat(1,1), tolerance=1.0e-12_dp)

    allocate(out_mat2(coarse%nx, coarse%ny))
    call scaler%execute(data, out_mat2) ! dp 2d -> 2d
    @assertEqual(out_mat2(1,1), 2.5_dp, tolerance=1.0e-12_dp)

    packed_dp = fine%pack(data)
    call scaler%execute(packed_dp, out_mat2) ! dp 1d -> 2d
    @assertEqual(out_mat2(1,1), 2.5_dp, tolerance=1.0e-12_dp)

    allocate(i_mat(coarse%nx, coarse%ny))
    packed_i = fine%pack(idata)
    call scaler%execute(packed_i, i_mat, upscaling_operator=up_sum) ! i4 1d -> 2d
    @assertEqual(i_mat(1,1), 10_i4)

    call scaler%execute(packed_i, out_mat2, upscaling_operator=up_sum) ! i4 -> dp 2d
    @assertEqual(out_mat2(1,1), 10.0_dp, tolerance=1.0e-12_dp)

    call scaler%execute(packed_i, out_mat2, upscaling_operator=up_median) ! i4 -> dp 2d
    @assertEqual(out_mat2(1,1), 2.5_dp, tolerance=1.0e-12_dp)

    allocate(loc_ids(coarse%ncells))
    call scaler%maxloc(data, loc_ids)
    @assertEqual(loc_ids, [4_i8], message='public maxloc returns fine cell ID for unpacked real input')
    call scaler%minloc(idata, loc_ids)
    @assertEqual(loc_ids, [1_i8], message='public minloc returns fine cell ID for unpacked integer input')
    call scaler%maxloc(packed_dp, loc_ids)
    @assertEqual(loc_ids, [4_i8], message='public maxloc returns fine cell ID for packed real input')
    call scaler%minloc(packed_i, loc_ids)
    @assertEqual(loc_ids, [1_i8], message='public minloc returns fine cell ID for packed integer input')

    call scaler%coarse_ij(fine_i=2_i4, fine_j=1_i4, coarse_i=ci, coarse_j=cj)
    @assertEqual([ci, cj], [1_i4, 1_i4])
  end subroutine test_stats_and_weight_count

  @test
  subroutine test_area_weight_normalization()
    implicit none
    type(grid_t), target :: fine, coarse
    type(scaler_t) :: scaler
    logical :: mask(2,2)
    real(dp) :: data(2,2), out(1), fraction
    integer(i4) :: classes(2,2)

    mask = reshape([.true., .true., .true., .false.], [2,2])
    call fine%init(nx=2, ny=2, cellsize=1.0_dp, coordsys=cartesian, y_direction=bottom_up, mask=mask)
    call coarse%init(nx=1, ny=1, cellsize=2.0_dp, coordsys=cartesian, y_direction=bottom_up)
    fine%cell_area = [1.0_dp, 2.0_dp, 3.0_dp]
    coarse%cell_area = [100.0_dp]
    call scaler%init(fine, coarse, weight_mode=weight_area)

    data = reshape([2.0_dp, 4.0_dp, 10.0_dp, 0.0_dp], [2,2])
    call scaler%execute(data, out, upscaling_operator=up_a_mean)
    @assertEqual(out(1), 20.0_dp / 3.0_dp, tolerance=1.0e-12_dp, message='area mean normalizes active fine-cell areas independently of coarse area')
    call scaler%execute(data, out, upscaling_operator=up_p_mean, p=2.0_dp)
    @assertEqual(out(1), sqrt(56.0_dp), tolerance=1.0e-12_dp, message='area p-mean uses normalized fine-cell areas')
    call scaler%execute(data, out, upscaling_operator=up_var)
    @assertEqual(out(1), 104.0_dp / 9.0_dp, tolerance=1.0e-12_dp, message='area variance uses normalized fine-cell areas')

    classes = reshape([1_i4, 2_i4, 2_i4, 0_i4], [2,2])
    fraction = scaler%cell_fraction(classes, 1_i8, 1_i4)
    @assertEqual(fraction, 1.0_dp / 6.0_dp, tolerance=1.0e-12_dp, message='cell_fraction exposes normalized area behavior without exposing weights')
    call scaler%execute(classes, out, upscaling_operator=up_fraction, class_id=1_i4)
    @assertEqual(out(1), 1.0_dp / 6.0_dp, tolerance=1.0e-12_dp, message='area fraction uses normalized fine-cell areas')

    call scaler%init(fine, coarse, weight_mode=weight_count)
    fraction = scaler%cell_fraction(classes, 1_i8, 1_i4)
    @assertEqual(fraction, 1.0_dp / 3.0_dp, tolerance=1.0e-12_dp, message='cell_fraction respects count weighting')
    fraction = fraction + scaler%cell_fraction(classes, 1_i8, 2_i4)
    @assertEqual(fraction, 1.0_dp, tolerance=1.0e-12_dp, message='multiple classes in one coarse cell partition active fine cells')
  end subroutine test_area_weight_normalization

  @test
  subroutine test_scaler_reinitialization()
    implicit none
    type(grid_t), target :: fine, coarse
    type(scaler_t) :: scaler
    real(dp) :: fine_data(4), coarse_data(1), coarse_out(1), fine_out(4), identity_out(4)

    call fine%init(nx=2, ny=2, cellsize=1.0_dp, coordsys=cartesian, y_direction=bottom_up)
    call coarse%init(nx=1, ny=1, cellsize=2.0_dp, coordsys=cartesian, y_direction=bottom_up)

    fine_data = [1.0_dp, 2.0_dp, 3.0_dp, 4.0_dp]
    call scaler%init(fine, coarse, cache_bounds=.true.)
    call scaler%execute(fine_data, coarse_out, upscaling_operator=up_a_mean)
    @assertEqual(coarse_out(1), 2.5_dp, tolerance=1.0e-12_dp, message='initial upscaling result')

    coarse_data = [8.0_dp]
    call scaler%init(coarse, fine, cache_bounds=.false., weight_mode=weight_count)
    call scaler%execute(coarse_data, fine_out, downscaling_operator=down_split)
    @assertEqual(fine_out, [2.0_dp, 2.0_dp, 2.0_dp, 2.0_dp], tolerance=1.0e-12_dp, message='reinitialization clears upscaling caches')

    call scaler%init(fine, fine)
    call scaler%execute(fine_data, identity_out)
    @assertEqual(identity_out, fine_data, tolerance=1.0e-12_dp, message='reinitialization clears downscaling caches')
  end subroutine test_scaler_reinitialization

  @test
  subroutine test_median_masked()
    implicit none
    type(grid_t), target :: fine, coarse
    type(scaler_t) :: scaler
    logical :: mask(4,2)
    real(dp) :: data(4,2)
    integer(i4) :: idata(4,2)
    real(dp), allocatable :: out(:)

    mask = .false.
    mask(2,1) = .true.
    mask(3,1) = .true.
    mask(4,1) = .true.

    call fine%init(nx=4, ny=2, cellsize=1.0_dp, coordsys=cartesian, y_direction=bottom_up, mask=mask)
    call coarse%init(nx=2, ny=1, cellsize=2.0_dp, coordsys=cartesian, y_direction=bottom_up)
    call scaler%init(fine, coarse)

    data = reshape([ &
      10.0_dp, 20.0_dp, 3.0_dp, 4.0_dp, &
      30.0_dp, 40.0_dp, 100.0_dp, 200.0_dp &
    ], [4,2])
    idata = nint(data, i4)
    allocate(out(coarse%ncells))

    call scaler%execute(data, out, upscaling_operator=up_median)
    @assertEqual(out(1), 20.0_dp, tolerance=1.0e-12_dp)
    @assertEqual(out(2), 3.5_dp, tolerance=1.0e-12_dp)

    call scaler%execute(idata, out, upscaling_operator=up_median)
    @assertEqual(out(1), 20.0_dp, tolerance=1.0e-12_dp)
    @assertEqual(out(2), 3.5_dp, tolerance=1.0e-12_dp)
  end subroutine test_median_masked

  @test
  subroutine test_laf_masked_direct_and_packed()
    implicit none
    type(grid_t), target :: fine, coarse
    type(scaler_t) :: scaler
    logical :: mask(2,2)
    integer(i4) :: idata(2,2)
    integer(i4), allocatable :: out(:), packed_i(:)

    mask = .false.
    mask(1,1) = .true.

    call fine%init(nx=2, ny=2, cellsize=1.0_dp, coordsys=cartesian, y_direction=bottom_up, mask=mask)
    call coarse%init(nx=1, ny=1, cellsize=2.0_dp, coordsys=cartesian, y_direction=bottom_up)
    call scaler%init(fine, coarse)

    idata = reshape([1_i4, 2_i4, 2_i4, 2_i4], [2,2])
    allocate(out(coarse%ncells))

    call scaler%execute(idata, out, upscaling_operator=up_laf, vmin=1_i4, vmax=2_i4)
    @assertEqual(out(1), 1_i4)

    packed_i = fine%pack(idata)
    call scaler%execute(packed_i, out, upscaling_operator=up_laf, vmin=1_i4, vmax=2_i4)
    @assertEqual(out(1), 1_i4)
  end subroutine test_laf_masked_direct_and_packed

  @test
  subroutine test_fill_missing()
    implicit none
    type(grid_t), target :: equal_source, equal_target, equal_flip_source, equal_flip_target
    type(grid_t), target :: equal_subset_source, equal_subset_target, up_fine, up_coarse
    type(grid_t), target :: down_coarse, down_fine, periodic_source, periodic_target
    type(scaler_t) :: equal_scaler, equal_flip_scaler, equal_subset_scaler
    type(scaler_t) :: up_scaler, down_scaler, periodic_scaler
    logical :: equal_source_mask(3, 1), equal_target_mask(3, 1)
    logical :: equal_flip_source_mask(1, 3), equal_subset_target_mask(1, 3)
    logical :: up_mask(4, 1), down_mask(2, 1), down_fine_mask(4, 1)
    logical :: periodic_source_mask(4, 1), periodic_target_mask(4, 1)
    real(dp) :: equal_in(2), equal_out(3), up_in(2), up_out(2), mixed_out(2)
    real(dp) :: equal_flip_in(2), equal_flip_out(3), equal_subset_in(3), equal_subset_out(2)
    real(dp) :: down_in(1), down_out(3), periodic_in(1), periodic_out(2)
    integer(i4) :: up_i(2), up_i_out(2), up_classes(4,1), down_i_in(1), down_i_out(3)

    equal_source_mask = reshape([.true., .true., .false.], [3, 1])
    equal_target_mask = .true.
    call equal_source%init(nx=3, ny=1, cellsize=1.0_dp, coordsys=cartesian, &
                           y_direction=bottom_up, mask=equal_source_mask)
    call equal_target%init(nx=3, ny=1, cellsize=1.0_dp, coordsys=cartesian, &
                           y_direction=bottom_up, mask=equal_target_mask)
    call equal_scaler%init(equal_source, equal_target, fill_missing=.true.)
    equal_in = [10.0_dp, 20.0_dp]
    call equal_scaler%execute(equal_in, equal_out)
    @assertEqual(equal_out, [10.0_dp, 20.0_dp, 20.0_dp], tolerance=1.0e-12_dp, message='equal-resolution scaling uses spatial filling by default')

    equal_flip_source_mask = reshape([.true., .true., .false.], [1, 3])
    call equal_flip_source%init(nx=1, ny=3, cellsize=1.0_dp, coordsys=cartesian, &
                                y_direction=bottom_up, mask=equal_flip_source_mask)
    call equal_flip_target%init(nx=1, ny=3, cellsize=1.0_dp, coordsys=cartesian, y_direction=top_down)
    call equal_flip_scaler%init(equal_flip_source, equal_flip_target, fill_missing=.true.)
    equal_flip_in = [10.0_dp, 20.0_dp]
    call equal_flip_scaler%execute(equal_flip_in, equal_flip_out)
    @assertEqual(equal_flip_out, [20.0_dp, 20.0_dp, 10.0_dp], tolerance=1.0e-12_dp, message='equal-resolution filling maps opposite y directions in target order')

    equal_subset_target_mask = reshape([.true., .false., .true.], [1, 3])
    call equal_subset_source%init(nx=1, ny=3, cellsize=1.0_dp, coordsys=cartesian, y_direction=bottom_up)
    call equal_subset_target%init(nx=1, ny=3, cellsize=1.0_dp, coordsys=cartesian, &
                                  y_direction=top_down, mask=equal_subset_target_mask)
    call equal_subset_scaler%init(equal_subset_source, equal_subset_target)
    equal_subset_in = [10.0_dp, 20.0_dp, 30.0_dp]
    call equal_subset_scaler%execute(equal_subset_in, equal_subset_out)
    @assertEqual(equal_subset_out, [30.0_dp, 10.0_dp], tolerance=1.0e-12_dp, message='strict equal-resolution mapping supports opposite y directions and target subsets')

    up_mask = reshape([.true., .true., .false., .false.], [4, 1])
    call up_fine%init(nx=4, ny=1, cellsize=1.0_dp, coordsys=cartesian, y_direction=bottom_up, mask=up_mask)
    call up_coarse%init(nx=2, ny=1, cellsize=2.0_dp, coordsys=cartesian, y_direction=bottom_up)
    call up_scaler%init(up_fine, up_coarse, fill_missing=.true., use_index_distance=.true.)
    @assertEqual(up_scaler%n_subcells, [2_i4, 0_i4], message='empty active coarse targets retain zero sub-cell counts')
    up_classes = reshape([1_i4, 2_i4, 0_i4, 0_i4], [4,1])
    @assertEqual(up_scaler%cell_fraction(up_classes, 2_i8, 1_i4), 0.0_dp, tolerance=1.0e-12_dp, message='cell_fraction returns zero for empty coarse targets')

    up_in = [10.0_dp, 20.0_dp]
    call up_scaler%execute(up_in, up_out, upscaling_operator=up_a_mean)
    @assertEqual(up_out, [15.0_dp, 15.0_dp], tolerance=1.0e-12_dp, message='upscaling fills an empty coarse target after normalized area weighting')
    call up_scaler%execute(up_in, up_out, upscaling_operator=up_sum)
    @assertEqual(up_out, [30.0_dp, 30.0_dp], tolerance=1.0e-12_dp, message='upscaling fills completed sum results')

    up_i = [1_i4, 3_i4]
    call up_scaler%execute(up_i, up_i_out, upscaling_operator=up_max)
    @assertEqual(up_i_out, [3_i4, 3_i4], message='integer upscaling fills completed categorical results')
    call up_scaler%execute(up_i, mixed_out, upscaling_operator=up_fraction, class_id=1_i4)
    @assertEqual(mixed_out, [0.5_dp, 0.5_dp], tolerance=1.0e-12_dp, message='mixed upscaling fills normalized fraction results')

    down_mask = reshape([.true., .false.], [2, 1])
    down_fine_mask = reshape([.true., .true., .true., .false.], [4, 1])
    call down_coarse%init(nx=2, ny=1, cellsize=2.0_dp, coordsys=cartesian, y_direction=bottom_up, mask=down_mask)
    call down_fine%init(nx=4, ny=1, cellsize=1.0_dp, coordsys=cartesian, y_direction=bottom_up, mask=down_fine_mask)
    call down_scaler%init(down_coarse, down_fine, fill_missing=.true., use_index_distance=.true.)

    down_in = [8.0_dp]
    call down_scaler%execute(down_in, down_out, downscaling_operator=down_nearest)
    @assertEqual(down_out, [8.0_dp, 8.0_dp, 8.0_dp], tolerance=1.0e-12_dp, message='downscaling fills missing coarse source blocks before execution')
    down_i_in = [8_i4]
    call down_scaler%execute(down_i_in, down_i_out, downscaling_operator=down_nearest)
    @assertEqual(down_i_out, [8_i4, 8_i4, 8_i4], message='integer downscaling uses the filled coarse source mapping')
    call down_scaler%execute(down_in, down_out, downscaling_operator=down_split)
    @assertEqual(down_out, [4.0_dp, 4.0_dp, 8.0_dp], tolerance=1.0e-12_dp, message='down_split uses active fine-cell count of the filled destination block')
    call down_scaler%init(down_coarse, down_fine, fill_missing=.true., use_index_distance=.true., weight_mode=weight_count)
    call down_scaler%execute(down_in, down_out, downscaling_operator=down_split)
    @assertEqual(down_out, [4.0_dp, 4.0_dp, 8.0_dp], tolerance=1.0e-12_dp, message='filled down_split stays equal for count weighting')

    periodic_source_mask = .false.
    periodic_source_mask(1, 1) = .true.
    periodic_target_mask = .false.
    periodic_target_mask(1, 1) = .true.
    periodic_target_mask(4, 1) = .true.
    call periodic_source%init(nx=4, ny=1, xllcorner=0.0_dp, yllcorner=0.0_dp, cellsize=90.0_dp, &
                              coordsys=spherical, y_direction=bottom_up, mask=periodic_source_mask)
    call periodic_target%init(nx=4, ny=1, xllcorner=0.0_dp, yllcorner=0.0_dp, cellsize=90.0_dp, &
                              coordsys=spherical, y_direction=bottom_up, mask=periodic_target_mask)
    call periodic_scaler%init(periodic_source, periodic_target, fill_missing=.true., use_index_distance=.true.)
    periodic_in = [7.0_dp]
    call periodic_scaler%execute(periodic_in, periodic_out)
    @assertEqual(periodic_out, [7.0_dp, 7.0_dp], tolerance=1.0e-12_dp, message='periodic index-distance filling wraps longitude')
  end subroutine test_fill_missing

  @test
  subroutine test_nearest_regridder_matching_flipped()
    implicit none
    type(grid_t), target :: source, target_fill, target_derived
    type(nearest_regridder_t) :: fill_regridder, derived_regridder
    logical :: source_mask(1, 3)
    real(dp) :: source_data(2), filled_packed(3), filled_unpacked(1, 3)
    real(dp) :: derived_packed(2), derived_unpacked(1, 3)

    source_mask = reshape([.true., .true., .false.], [1, 3])
    call source%init(nx=1, ny=3, cellsize=1.0_dp, coordsys=cartesian, &
                     y_direction=bottom_up, mask=source_mask)
    call target_fill%init(nx=1, ny=3, cellsize=1.0_dp, coordsys=cartesian, y_direction=top_down)
    call target_derived%init(nx=1, ny=3, cellsize=1.0_dp, coordsys=cartesian, y_direction=top_down)
    source_data = [10.0_dp, 20.0_dp]

    call fill_regridder%init(source, target_fill)
    call fill_regridder%execute(source_data, filled_packed)
    @assertEqual(filled_packed, [20.0_dp, 20.0_dp, 10.0_dp], tolerance=1.0e-12_dp, message='matching-grid regridder fills opposite y directions in target packed order')
    call fill_regridder%execute(source_data, filled_unpacked)
    @assertEqual(filled_unpacked(1, :), [20.0_dp, 20.0_dp, 10.0_dp], tolerance=1.0e-12_dp, message='matching-grid regridder preserves target orientation for unpacked output')

    call derived_regridder%init(source, target_derived, derive_target_mask=.true.)
    @assertTrue(all(target_derived%mask(1, :) .eqv. [.false., .true., .true.]))
    call derived_regridder%execute(source_data, derived_packed)
    @assertEqual(derived_packed, [20.0_dp, 10.0_dp], tolerance=1.0e-12_dp, message='derived matching-grid mask intersects physically corresponding rows')
    call derived_regridder%execute(source_data, derived_unpacked)
    @assertEqual(derived_unpacked(1, 1), nodata_dp, tolerance=1.0e-12_dp)
    @assertEqual(derived_unpacked(1, 2:3), [20.0_dp, 10.0_dp], tolerance=1.0e-12_dp)
  end subroutine test_nearest_regridder_matching_flipped

  @test
  subroutine test_nearest_regridder_cartesian()
    implicit none
    type(grid_t), target :: source, target
    type(nearest_regridder_t) :: regridder
    real(dp) :: dp_in(2), dp_in_mat(2,1), dp_out(3), dp_out_mat(3,1)
    integer(i4) :: i_in(2), i_in_mat(2,1), i_out(3), i_out_mat(3,1)

    call source%init(nx=2, ny=1, xllcorner=0.0_dp, yllcorner=0.0_dp, cellsize=2.0_dp, &
                     coordsys=cartesian, y_direction=bottom_up)
    call target%init(nx=3, ny=1, xllcorner=0.4_dp, yllcorner=0.0_dp, cellsize=0.75_dp, &
                     coordsys=cartesian, y_direction=bottom_up)

    call regridder%init(source, target)

    dp_in = [10.0_dp, 20.0_dp]
    dp_in_mat = reshape(dp_in, [2, 1])
    i_in = [1_i4, 2_i4]
    i_in_mat = reshape(i_in, [2, 1])

    call regridder%execute(dp_in, dp_out)
    @assertEqual(dp_out, [10.0_dp, 10.0_dp, 20.0_dp], tolerance=1.0e-12_dp)

    call regridder%execute(dp_in_mat, dp_out_mat)
    @assertEqual(dp_out_mat(:,1), [10.0_dp, 10.0_dp, 20.0_dp], tolerance=1.0e-12_dp)

    call regridder%execute(i_in, i_out)
    @assertEqual(i_out, [1_i4, 1_i4, 2_i4])

    call regridder%execute(i_in_mat, i_out_mat)
    @assertEqual(i_out_mat(:,1), [1_i4, 1_i4, 2_i4])
  end subroutine test_nearest_regridder_cartesian

  @test
  subroutine test_nearest_regridder_masked_and_aux()
    implicit none
    type(grid_t), target :: source_masked, target_near, source_plain, target_masked, source_aux, target_aux
    type(nearest_regridder_t) :: masked_regridder, target_regridder, aux_regridder
    logical :: source_mask(3,1), target_mask(3,1)
    real(dp) :: masked_out(1), target_out(3,1), aux_out(2)

    source_mask = .true.
    source_mask(2,1) = .false.
    call source_masked%init(nx=3, ny=1, xllcorner=0.0_dp, yllcorner=0.0_dp, cellsize=1.0_dp, &
                            coordsys=cartesian, y_direction=bottom_up, mask=source_mask)
    call target_near%init(nx=1, ny=1, xllcorner=1.1_dp, yllcorner=0.0_dp, cellsize=1.0_dp, &
                          coordsys=cartesian, y_direction=bottom_up)
    call masked_regridder%init(source_masked, target_near)
    call masked_regridder%execute([10.0_dp, 30.0_dp], masked_out)
    @assertEqual(masked_out(1), 30.0_dp, tolerance=1.0e-12_dp)

    target_mask = .true.
    target_mask(2,1) = .false.
    call source_plain%init(nx=2, ny=1, xllcorner=0.0_dp, yllcorner=0.0_dp, cellsize=1.0_dp, &
                           coordsys=cartesian, y_direction=bottom_up)
    call target_masked%init(nx=3, ny=1, xllcorner=0.0_dp, yllcorner=0.0_dp, cellsize=1.0_dp, &
                            coordsys=cartesian, y_direction=bottom_up, mask=target_mask)
    call target_regridder%init(source_plain, target_masked)
    call target_regridder%execute([1.0_dp, 2.0_dp], target_out)
    @assertEqual(target_out(1,1), 1.0_dp, tolerance=1.0e-12_dp)
    @assertEqual(target_out(2,1), nodata_dp, tolerance=1.0e-12_dp)
    @assertEqual(target_out(3,1), 2.0_dp, tolerance=1.0e-12_dp)

    call source_aux%init(nx=2, ny=1, xllcorner=0.0_dp, yllcorner=0.0_dp, cellsize=1.0_dp, &
                         coordsys=cartesian, y_direction=bottom_up)
    call target_aux%init(nx=2, ny=1, xllcorner=10.0_dp, yllcorner=0.0_dp, cellsize=1.0_dp, &
                         coordsys=cartesian, y_direction=bottom_up)
    allocate(source_aux%lon(source_aux%nx, source_aux%ny), source_aux%lat(source_aux%nx, source_aux%ny))
    allocate(target_aux%lon(target_aux%nx, target_aux%ny), target_aux%lat(target_aux%nx, target_aux%ny))
    source_aux%lon(:,1) = [0.0_dp, 10.0_dp]
    source_aux%lat(:,1) = [0.0_dp, 0.0_dp]
    target_aux%lon(:,1) = [9.0_dp, 1.0_dp]
    target_aux%lat(:,1) = [0.0_dp, 0.0_dp]

    call aux_regridder%init(source_aux, target_aux, use_aux=.true.)
    call aux_regridder%execute([10.0_dp, 20.0_dp], aux_out)
    @assertEqual(aux_out, [20.0_dp, 10.0_dp], tolerance=1.0e-12_dp)
  end subroutine test_nearest_regridder_masked_and_aux

  @test
  subroutine test_nearest_regridder_spherical_and_mixed()
    implicit none
    type(grid_t), target :: source_sph, target_sph, target_cart_aux
    type(nearest_regridder_t) :: sph_regridder, mixed_regridder
    real(dp) :: sph_out(1), mixed_out(2)

    call source_sph%init(nx=4, ny=1, xllcorner=0.0_dp, yllcorner=-45.0_dp, cellsize=90.0_dp, &
                         coordsys=spherical, y_direction=bottom_up)
    call target_sph%init(nx=1, ny=1, xllcorner=330.0_dp, yllcorner=-20.0_dp, cellsize=40.0_dp, &
                         coordsys=spherical, y_direction=bottom_up)
    call sph_regridder%init(source_sph, target_sph)
    call sph_regridder%execute([1.0_dp, 2.0_dp, 3.0_dp, 4.0_dp], sph_out)
    @assertEqual(sph_out(1), 4.0_dp, tolerance=1.0e-12_dp)

    call target_cart_aux%init(nx=2, ny=1, xllcorner=0.0_dp, yllcorner=0.0_dp, cellsize=1.0_dp, &
                              coordsys=cartesian, y_direction=bottom_up)
    allocate(target_cart_aux%lon(target_cart_aux%nx, target_cart_aux%ny), &
             target_cart_aux%lat(target_cart_aux%nx, target_cart_aux%ny))
    target_cart_aux%lon(:,1) = [44.0_dp, 316.0_dp]
    target_cart_aux%lat(:,1) = [0.0_dp, 0.0_dp]

    call mixed_regridder%init(source_sph, target_cart_aux)
    call mixed_regridder%execute([1.0_dp, 2.0_dp, 3.0_dp, 4.0_dp], mixed_out)
    @assertEqual(mixed_out, [1.0_dp, 4.0_dp], tolerance=1.0e-12_dp)
  end subroutine test_nearest_regridder_spherical_and_mixed

  @test
  subroutine test_nearest_regridder_derived_mask_cartesian()
    implicit none
    type(grid_t), target :: source_masked, target_mid, source_small, target_wide, source_and, target_and, &
                            source_all_masked, target_empty, target_area
    type(nearest_regridder_t) :: derived_regridder, outside_regridder, and_regridder, empty_regridder, area_regridder
    logical :: source_mask(3,1), source_and_mask(3,1), target_and_mask(3,1), all_mask(2,1)
    real(dp) :: target_out(3,1), outside_out(4,1), and_out(3,1), empty_out(2,1), target_packed(2), outside_packed(2)
    real(dp), allocatable :: empty_in(:)

    source_mask = .true.
    source_mask(2,1) = .false.
    call source_masked%init(nx=3, ny=1, xllcorner=0.0_dp, yllcorner=0.0_dp, cellsize=1.0_dp, &
                            coordsys=cartesian, y_direction=bottom_up, mask=source_mask)

    call target_mid%init(nx=3, ny=1, xllcorner=0.0_dp, yllcorner=0.0_dp, cellsize=1.0_dp, &
                         coordsys=cartesian, y_direction=bottom_up)
    call derived_regridder%init(source_masked, target_mid, derive_target_mask=.true.)
    @assertEqual(target_mid%ncells, 2_i8)
    @assertTrue(all(target_mid%mask(:,1) .eqv. [.true., .false., .true.]))
    call derived_regridder%execute([10.0_dp, 30.0_dp], target_packed)
    @assertEqual(target_packed, [10.0_dp, 30.0_dp], tolerance=1.0e-12_dp)
    call derived_regridder%execute([10.0_dp, 30.0_dp], target_out)
    @assertEqual(target_out(1,1), 10.0_dp, tolerance=1.0e-12_dp)
    @assertEqual(target_out(2,1), nodata_dp, tolerance=1.0e-12_dp)
    @assertEqual(target_out(3,1), 30.0_dp, tolerance=1.0e-12_dp)

    call source_small%init(nx=2, ny=1, xllcorner=0.0_dp, yllcorner=0.0_dp, cellsize=1.0_dp, &
                           coordsys=cartesian, y_direction=bottom_up)
    call target_wide%init(nx=4, ny=1, xllcorner=-1.0_dp, yllcorner=0.0_dp, cellsize=1.0_dp, &
                          coordsys=cartesian, y_direction=bottom_up)
    call outside_regridder%init(source_small, target_wide, derive_target_mask=.true.)
    @assertEqual(target_wide%ncells, 2_i8)
    @assertTrue(all(target_wide%mask(:,1) .eqv. [.false., .true., .true., .false.]))
    call outside_regridder%execute([10.0_dp, 20.0_dp], outside_packed)
    @assertEqual(outside_packed, [10.0_dp, 20.0_dp], tolerance=1.0e-12_dp)
    call outside_regridder%execute([10.0_dp, 20.0_dp], outside_out)
    @assertEqual(outside_out(1,1), nodata_dp, tolerance=1.0e-12_dp)
    @assertEqual(outside_out(2,1), 10.0_dp, tolerance=1.0e-12_dp)
    @assertEqual(outside_out(3,1), 20.0_dp, tolerance=1.0e-12_dp)
    @assertEqual(outside_out(4,1), nodata_dp, tolerance=1.0e-12_dp)

    source_and_mask(:,1) = [.false., .true., .true.]
    target_and_mask(:,1) = [.true., .false., .true.]
    call source_and%init(nx=3, ny=1, xllcorner=0.0_dp, yllcorner=0.0_dp, cellsize=1.0_dp, &
                         coordsys=cartesian, y_direction=bottom_up, mask=source_and_mask)
    call target_and%init(nx=3, ny=1, xllcorner=0.0_dp, yllcorner=0.0_dp, cellsize=1.0_dp, &
                         coordsys=cartesian, y_direction=bottom_up, mask=target_and_mask)
    call and_regridder%init(source_and, target_and, derive_target_mask=.true.)
    @assertEqual(target_and%ncells, 1_i8)
    @assertTrue(all(target_and%mask(:,1) .eqv. [.false., .false., .true.]))
    call and_regridder%execute([20.0_dp, 30.0_dp], and_out)
    @assertEqual(and_out(1,1), nodata_dp, tolerance=1.0e-12_dp)
    @assertEqual(and_out(2,1), nodata_dp, tolerance=1.0e-12_dp)
    @assertEqual(and_out(3,1), 30.0_dp, tolerance=1.0e-12_dp)

    call target_area%init(nx=3, ny=1, xllcorner=0.0_dp, yllcorner=0.0_dp, cellsize=1.0_dp, &
                          coordsys=cartesian, y_direction=bottom_up)
    target_area%cell_area = [1.0_dp, 2.0_dp, 3.0_dp]
    call area_regridder%init(source_masked, target_area, derive_target_mask=.true.)
    @assertEqual(target_area%ncells, 2_i8)
    @assertEqual(target_area%cell_area, [1.0_dp, 3.0_dp], tolerance=1.0e-12_dp)

    all_mask = .false.
    call source_all_masked%init(nx=2, ny=1, xllcorner=0.0_dp, yllcorner=0.0_dp, cellsize=1.0_dp, &
                                coordsys=cartesian, y_direction=bottom_up, mask=all_mask)
    call target_empty%init(nx=2, ny=1, xllcorner=0.0_dp, yllcorner=0.0_dp, cellsize=1.0_dp, &
                           coordsys=cartesian, y_direction=bottom_up)
    call empty_regridder%init(source_all_masked, target_empty, derive_target_mask=.true.)
    @assertEqual(target_empty%ncells, 0_i8)
    @assertTrue(all(.not. target_empty%mask(:,1)))
    allocate(empty_in(0))
    call empty_regridder%execute(empty_in, empty_out)
    @assertEqual(empty_out(1,1), nodata_dp, tolerance=1.0e-12_dp)
    @assertEqual(empty_out(2,1), nodata_dp, tolerance=1.0e-12_dp)
  end subroutine test_nearest_regridder_derived_mask_cartesian

  @test
  subroutine test_nearest_regridder_derived_mask_spherical_aux()
    implicit none
    type(grid_t), target :: source_sph_masked, target_sph, source_aux_masked, target_aux
    type(nearest_regridder_t) :: sph_mask_regridder, aux_mask_regridder
    logical :: sph_mask(4,1), aux_mask(2,2)
    real(dp) :: sph_out(1,1), aux_out(2,1)

    sph_mask = .true.
    sph_mask(4,1) = .false.
    call source_sph_masked%init(nx=4, ny=1, xllcorner=0.0_dp, yllcorner=-45.0_dp, cellsize=90.0_dp, &
                                coordsys=spherical, y_direction=bottom_up, mask=sph_mask)
    call target_sph%init(nx=1, ny=1, xllcorner=330.0_dp, yllcorner=-20.0_dp, cellsize=40.0_dp, &
                         coordsys=spherical, y_direction=bottom_up)
    call sph_mask_regridder%init(source_sph_masked, target_sph, derive_target_mask=.true.)
    @assertEqual(target_sph%ncells, 0_i8)
    call sph_mask_regridder%execute([1.0_dp, 2.0_dp, 3.0_dp], sph_out)
    @assertEqual(sph_out(1,1), nodata_dp, tolerance=1.0e-12_dp)

    aux_mask = reshape([.true., .false., .true., .true.], [2, 2])
    call source_aux_masked%init(nx=2, ny=2, xllcorner=0.0_dp, yllcorner=0.0_dp, cellsize=1.0_dp, &
                                coordsys=cartesian, y_direction=bottom_up, mask=aux_mask)
    call target_aux%init(nx=2, ny=1, xllcorner=10.0_dp, yllcorner=0.0_dp, cellsize=1.0_dp, &
                         coordsys=cartesian, y_direction=bottom_up)
    allocate(source_aux_masked%lon(source_aux_masked%nx, source_aux_masked%ny), &
             source_aux_masked%lat(source_aux_masked%nx, source_aux_masked%ny))
    allocate(target_aux%lon(target_aux%nx, target_aux%ny), target_aux%lat(target_aux%nx, target_aux%ny))
    source_aux_masked%lon = reshape([0.5_dp, 1.5_dp, 0.5_dp, 1.5_dp], [2, 2])
    source_aux_masked%lat = reshape([0.5_dp, 0.5_dp, 1.5_dp, 1.5_dp], [2, 2])
    target_aux%lon(:,1) = [1.5_dp, 0.5_dp]
    target_aux%lat(:,1) = [0.5_dp, 1.5_dp]

    call aux_mask_regridder%init(source_aux_masked, target_aux, use_aux=.true., derive_target_mask=.true.)
    @assertTrue(source_aux_masked%has_aux_vertices())
    @assertEqual(target_aux%ncells, 1_i8)
    @assertTrue(all(target_aux%mask(:,1) .eqv. [.false., .true.]))
    call aux_mask_regridder%execute([10.0_dp, 20.0_dp, 30.0_dp], aux_out)
    @assertEqual(aux_out(1,1), nodata_dp, tolerance=1.0e-12_dp)
    @assertEqual(aux_out(2,1), 20.0_dp, tolerance=1.0e-12_dp)
  end subroutine test_nearest_regridder_derived_mask_spherical_aux

  @test
  subroutine test_mapping_destroy()
    type(grid_t), target :: fine, coarse
    type(scaler_t) :: scaler
    type(nearest_regridder_t) :: regridder
    real(dp) :: coarse_result(1), fine_result(4)

    call scaler%destroy()
    call regridder%destroy()
    call fine%init(nx=2_i4, ny=2_i4, cellsize=1.0_dp, y_direction=bottom_up)
    call coarse%init(nx=1_i4, ny=1_i4, cellsize=2.0_dp, y_direction=bottom_up)

    call scaler%init(fine, coarse, cache_bounds=.true.)
    @assertTrue(allocated(scaler%id_map))
    call scaler%destroy()
    call scaler%destroy()
    @assertFalse(allocated(scaler%id_map))
    @assertFalse(allocated(scaler%n_subcells))
    @assertFalse(associated(scaler%source_grid))
    @assertFalse(associated(scaler%target_grid))
    @assertFalse(associated(scaler%fine_grid))
    @assertFalse(associated(scaler%coarse_grid))
    @assertEqual(scaler%factor, 0_i4)
    @assertEqual(fine%ncells, 4_i8)
    @assertEqual(coarse%ncells, 1_i8)
    call scaler%init(fine, coarse)
    call scaler%execute([1.0_dp, 2.0_dp, 3.0_dp, 4.0_dp], coarse_result)
    @assertEqual(coarse_result, [2.5_dp], tolerance=1.0e-12_dp)

    call regridder%init(fine, fine)
    @assertTrue(allocated(regridder%id_map))
    call regridder%destroy()
    call regridder%destroy()
    @assertFalse(allocated(regridder%id_map))
    @assertFalse(associated(regridder%source_grid))
    @assertFalse(associated(regridder%target_grid))
    @assertEqual(fine%ncells, 4_i8)
    call regridder%init(fine, fine)
    call regridder%execute([1.0_dp, 2.0_dp, 3.0_dp, 4.0_dp], fine_result)
    @assertEqual(fine_result, [1.0_dp, 2.0_dp, 3.0_dp, 4.0_dp], tolerance=0.0_dp)
  end subroutine test_mapping_destroy

end module test_mo_grid_scaler
