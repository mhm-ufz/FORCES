module test_mo_grid_io
  use funit
  implicit none

  private

  public :: test_output, test_output_cache, test_output_cache_static_contiguous, test_single_month_input
  public :: test_cf_packing_roundtrip

contains

  @test
  subroutine test_output()
    call run_output_case("height.nc")
  end subroutine test_output

  @test
  subroutine test_output_cache()
    use mo_kind, only: i4
    implicit none
    call run_output_case("height_cache.nc", cache_size=16_i4)
  end subroutine test_output_cache

  @test
  subroutine test_output_cache_static_contiguous()
    use mo_kind, only: i4
    implicit none
    call run_output_case("height_cache_static.nc", cache_size=16_i4, static_contiguous=.true.)
  end subroutine test_output_cache_static_contiguous

  @test
  subroutine test_single_month_input()
    use mo_grid, only: grid_t
    use mo_grid_io, only: add_var, var, output_dataset, input_dataset, monthly
    use mo_datetime, only: datetime
    use mo_kind, only: dp, i4
    use mo_timeseries, only: time_t
    implicit none
    type(grid_t), target :: grid
    type(output_dataset) :: out_ds
    type(input_dataset) :: in_ds
    type(time_t) :: axis
    type(var), allocatable :: vars(:)
    real(dp), allocatable :: height(:)

    call grid%from_ascii_file("./files/dem.asc")
    allocate(height(grid%ncells), source=1.0_dp)
    allocate(vars(0))
    call add_var(vars, var(name="height", units="m", static=.false.))

    call out_ds%init("single_month.nc", grid=grid, vars=vars, start_time=datetime("2000-01-01"), delta="days")
    call out_ds%update("height", height)
    call out_ds%write(datetime("2000-02-01"))
    call out_ds%close()

    call in_ds%init("single_month.nc", grid=grid, vars=vars)
    axis = in_ds%time_axis()
    @assertEqual(in_ds%timestep, monthly, message="single bounded input month")
    @assertEqual(axis%timestep, monthly, message="single bounded time axis month")
    @assertEqual(axis%bounds(:, 1_i4), [0_i4, 31_i4], message="single bounded time axis bounds")
    call in_ds%close()
  end subroutine test_single_month_input

  @test
  subroutine test_cf_packing_roundtrip()
    use mo_datetime, only: datetime
    use mo_grid, only: grid_t
    use mo_grid_io, only: add_var, var, output_dataset, input_dataset
    use mo_kind, only: dp, i1, i2, i4, i8, sp
    use mo_netcdf, only: NcDataset, NcVariable
    implicit none
    type(grid_t), target :: grid
    type(output_dataset) :: out_ds
    type(input_dataset) :: in_ds
    type(NcDataset) :: nc
    type(NcVariable) :: nc_var
    type(var), allocatable :: vars(:)
    type(var) :: meta
    real(dp), allocatable :: static_values(:), static_read(:), temporal_read(:), temporal_chunk(:, :)
    real(dp), allocatable :: layered_values(:, :), layered_read(:, :), layered_chunk(:, :, :)
    real(sp), allocatable :: static_read_sp(:), temporal_values(:)
    integer(i1), allocatable :: static_read_i1(:)
    integer(i2), allocatable :: raw(:, :)
    integer(i2), allocatable :: static_read_i2(:)
    integer(i4), allocatable :: static_read_i4(:), temporal_read_i4(:), temporal_chunk_i4(:, :)
    integer(i4), allocatable :: layered_read_i4(:, :), layered_chunk_i4(:, :, :)
    integer(i8), allocatable :: static_read_i8(:)

    call grid%from_ascii_file("./files/dem.asc")
    allocate(static_values(grid%ncells), source=11.0_dp)
    allocate(temporal_values(grid%ncells), source=2.0_sp)
    allocate(vars(0))
    call add_var(vars, var(name="packed_static", static=.true., allow_static=.true., dtype="i16", kind="dp", &
                           scale_dtype="f32", scale_factor=0.5_dp, add_offset=10.0_dp))
    call add_var(vars, var(name="packed_temporal", dtype="i16", kind="sp", scale_dtype="f64", &
                           scale_factor=0.25_dp))
    call add_var(vars, var(name="packed_layered", dtype="i16", kind="dp", scale_dtype="f64", layered=.true., &
                           scale_factor=0.5_dp, add_offset=0.0_dp))
    allocate(layered_values(grid%ncells, 2_i4))
    layered_values(:, 1) = 5.0_dp
    layered_values(:, 2) = 6.0_dp

    call out_ds%init("grid_cf_packing.nc", grid=grid, vars=vars, start_time=datetime("2000-01-01"), delta="days", &
                     layer=[1.0_dp, 2.0_dp], layer_vertices=[0.5_dp, 1.5_dp, 2.5_dp])
    call out_ds%update("packed_static", static_values)
    call out_ds%write_static()
    call out_ds%update("packed_temporal", temporal_values)
    call out_ds%update_layered("packed_layered", layered_values)
    call out_ds%write(datetime("2000-01-02"))
    temporal_values = 2.25_sp
    layered_values = layered_values + 0.5_dp
    call out_ds%update("packed_temporal", temporal_values)
    call out_ds%update_layered("packed_layered", layered_values)
    call out_ds%write(datetime("2000-01-03"))
    call out_ds%close()

    nc = NcDataset("grid_cf_packing.nc", "r")
    nc_var = nc%getVariable("packed_static")
    @assertEqual(trim(nc_var%getAttributeDtype("scale_factor")), "f32")
    call nc_var%getData(raw)
    @assertTrue(all(raw == 2_i2 .or. raw == -9999_i2), message="grid writer stores packed codes and fill")
    nc_var = nc%getVariable("packed_temporal")
    @assertEqual(trim(nc_var%getAttributeDtype("scale_factor")), "f64")
    @assertFalse(nc_var%hasAttribute("add_offset"), message="grid factor-only output omits add_offset")
    call nc%close()

    call in_ds%init("grid_cf_packing.nc", grid=grid, vars=vars)
    meta = in_ds%meta("packed_static")
    @assertEqual(trim(meta%dtype), "i16")
    @assertEqual(trim(meta%kind), "dp")
    @assertEqual(trim(meta%scale_dtype), "f32")
    allocate(static_read(grid%ncells), static_read_sp(grid%ncells), temporal_read(grid%ncells))
    allocate(layered_read(grid%ncells, 2_i4))
    allocate(static_read_i1(grid%ncells), static_read_i2(grid%ncells), static_read_i4(grid%ncells), &
             static_read_i8(grid%ncells), temporal_read_i4(grid%ncells), layered_read_i4(grid%ncells, 2_i4))
    call in_ds%read("packed_static", static_read)
    call in_ds%read("packed_static", static_read_sp)
    call in_ds%read("packed_static", static_read_i1)
    call in_ds%read("packed_static", static_read_i2)
    call in_ds%read("packed_static", static_read_i4)
    call in_ds%read("packed_static", static_read_i8)
    call in_ds%read("packed_temporal", temporal_read, current_time=datetime("2000-01-03"))
    call in_ds%read("packed_temporal", temporal_read_i4, current_time=datetime("2000-01-03"))
    call in_ds%read_layered("packed_layered", layered_read, current_time=datetime("2000-01-03"))
    call in_ds%read_layered("packed_layered", layered_read_i4, current_time=datetime("2000-01-03"))
    call in_ds%read_chunk("packed_temporal", temporal_chunk, &
                          timeframe_start=datetime("2000-01-01"), timeframe_end=datetime("2000-01-03"))
    call in_ds%read_chunk("packed_temporal", temporal_chunk_i4, &
                          timeframe_start=datetime("2000-01-01"), timeframe_end=datetime("2000-01-03"))
    call in_ds%read_chunk_layered("packed_layered", layered_chunk, &
                                  timeframe_start=datetime("2000-01-01"), timeframe_end=datetime("2000-01-03"))
    call in_ds%read_chunk_layered("packed_layered", layered_chunk_i4, &
                                  timeframe_start=datetime("2000-01-01"), timeframe_end=datetime("2000-01-03"))
    call in_ds%close()
    @assertEqual(static_read, static_values, tolerance=1.0e-12_dp)
    @assertEqual(static_read_sp, real(static_values, sp), tolerance=1.0e-6_sp)
    @assertTrue(all(static_read_i1 == 11_i1), message="packed static read into i1")
    @assertTrue(all(static_read_i2 == 11_i2), message="packed static read into i2")
    @assertTrue(all(static_read_i4 == 11_i4), message="packed static read into i4")
    @assertTrue(all(static_read_i8 == 11_i8), message="packed static read into i8")
    @assertEqual(temporal_read, real(temporal_values, dp), tolerance=1.0e-12_dp)
    @assertTrue(all(temporal_read_i4 == 2_i4), message="packed real values truncate toward zero into integers")
    @assertEqual(layered_read, layered_values, tolerance=1.0e-12_dp)
    @assertTrue(all(layered_read_i4(:, 1) == 5_i4), message="packed layered first layer into integers")
    @assertTrue(all(layered_read_i4(:, 2) == 6_i4), message="packed layered second layer into integers")
    @assertEqual(shape(temporal_chunk), [int(grid%ncells, i4), 2_i4])
    @assertTrue(all(abs(temporal_chunk(:, 1) - 2.0_dp) < 1.0e-12_dp))
    @assertTrue(all(abs(temporal_chunk(:, 2) - 2.25_dp) < 1.0e-12_dp))
    @assertTrue(all(temporal_chunk_i4 == 2_i4), message="packed chunk read into integers")
    @assertEqual(shape(layered_chunk), [int(grid%ncells, i4), 2_i4, 2_i4])
    @assertTrue(all(abs(layered_chunk(:, :, 2) - layered_values) < 1.0e-12_dp))
    @assertTrue(all(layered_chunk_i4(:, 1, :) == 5_i4), message="packed layered first-layer chunk into integers")
    @assertTrue(all(layered_chunk_i4(:, 2, :) == 6_i4), message="packed layered second-layer chunk into integers")
  end subroutine test_cf_packing_roundtrip

  subroutine run_output_case(outfile, cache_size, static_contiguous)
    use mo_kind, only: dp, i4, sp, i8
    use mo_grid, only: grid_t
    use mo_grid_io, only: add_var, var, output_dataset, center_timestamp, time_units_delta, daily, input_dataset
    use mo_datetime, only: datetime, timedelta
    use mo_timeseries, only: time_t, end_timestamp
    implicit none
    character(*), intent(in) :: outfile
    integer(i4), intent(in), optional :: cache_size
    logical, intent(in), optional :: static_contiguous
    type(datetime) :: start_time, end_time, current_time, ref_time
    type(timedelta) :: model_step
    type(grid_t), target :: grid, grd2
    type(output_dataset) :: out_ds
    type(input_dataset) :: in_ds
    type(time_t) :: time_axis
    type(datetime), allocatable :: times(:)
    real(dp), allocatable :: dem(:,:), height(:), heights(:), dem_read(:,:), height_read(:), h_chunk(:,:)
    real(sp), allocatable :: dem_sp(:,:)
    integer(i4), allocatable :: dem_i4(:,:), dem_int_read(:,:), height_i4(:)
    integer(i8), allocatable :: dem_i8(:,:)

    type(var), allocatable :: vars(:), in_vars(:)
    type(var) :: out_dem_meta, out_height_meta, in_dem_meta, in_height_meta
    real(dp) :: factor
    integer(i4) :: write_step
    character(:), allocatable :: delta
    real(dp) :: t=1.0E-5_dp

    ! model time config
    start_time = datetime("2025-01-01")
    end_time = datetime("2025-01-15")
    ref_time = datetime("1970-01-01")
    model_step = timedelta(hours=1_i4)

    ! output time config
    write_step = daily
    delta = time_units_delta(write_step, center_timestamp)

    ! initialize grid from DEM ascii file
    call grid%from_ascii_file("./files/dem.asc")
    call grid%read_data("./files/dem.asc", dem)
    height = grid%pack(dem)
    height_i4 = grid%pack(nint(dem, i4))

    allocate(vars(0))
    call add_var(vars, var(name="dem", units="m", static=.true., allow_static=.true., dtype="f32", kind="dp"))
    call add_var(vars, var(name="dem_int", units="m", static=.true., allow_static=.true., dtype="i32", kind="i4"))
    call add_var(vars, var(name="height", units="m", avg=.true., static=.false., allow_static=.true.))
    allocate(in_vars(0))
    call add_var(in_vars, var(name="dem", units="m", static=.false., allow_static=.true., dtype="f32", kind="dp"))
    call add_var(in_vars, var(name="dem_int", units="m", static=.false., allow_static=.true., dtype="i32", kind="i4"))
    call add_var(in_vars, var(name="height", units="m", static=.false., allow_static=.true.))
    if (present(cache_size)) then
      if (present(static_contiguous)) then
        call out_ds%init( &
          & path=outfile, &
          & grid=grid, &
          & vars=vars, &
          & start_time=start_time, &
          & ref_time=ref_time, &
          & delta=delta, &
          & timestamp=center_timestamp, &
          & cache_size=cache_size, &
          & static_contiguous=static_contiguous)
      else
        call out_ds%init( &
          & path=outfile, &
          & grid=grid, &
          & vars=vars, &
          & start_time=start_time, &
          & ref_time=ref_time, &
          & delta=delta, &
          & timestamp=center_timestamp, &
          & cache_size=cache_size)
      end if
    else
      call out_ds%init( &
        & path=outfile, &
        & grid=grid, &
        & vars=vars, &
        & start_time=start_time, &
        & ref_time=ref_time, &
        & delta=delta, &
        & timestamp=center_timestamp)
    end if
    out_dem_meta = out_ds%meta("dem")
    out_height_meta = out_ds%meta("height")
    @assertTrue(out_dem_meta%static, message='output meta keeps static flag')
    @assertFalse(out_dem_meta%allow_static, message='output should ignore allow_static')
    @assertFalse(out_height_meta%static, message='output meta keeps temporal flag')
    @assertFalse(out_height_meta%allow_static, message='output should ignore allow_static')

    call out_ds%update("dem", height)
    call out_ds%update("dem_int", height_i4)
    call out_ds%write_static()

    ! model time loop
    current_time = start_time
    factor = 0.0_dp
    allocate(heights(grid%ncells), source=0.0_dp)
    do while(current_time < end_time)
      factor = factor + 0.01_dp
      if (current_time%date()==datetime("2025-01-10")) heights = heights + height * cos(factor)
      current_time = current_time + model_step
      call out_ds%update("height", height * cos(factor))
      if (current_time%is_new_day()) call out_ds%write(current_time)
    end do
    call out_ds%close()

    heights = heights / 24.0_dp

    call grd2%from_netcdf(outfile, "height")
    @assertEqual(grid%ncells, grd2%ncells, message='ncells compare')
    @assertEqual(grid%nx, grd2%nx, message='nx compare')
    @assertEqual(grid%ny, grd2%ny, message='ny compare')
    @assertEqual(grid%xllcorner, grd2%xllcorner, tolerance=t, message='xllcorner compare')
    @assertEqual(grid%yllcorner, grd2%yllcorner, tolerance=t, message='yllcorner compare')

    call in_ds%init(outfile, grid=grd2, vars=in_vars)
    in_dem_meta = in_ds%meta("dem")
    in_height_meta = in_ds%meta("height")
    @assertTrue(in_dem_meta%static, message='input auto-detect static variable')
    @assertFalse(in_height_meta%static, message='input auto-detect temporal variable')
    @assertFalse(in_dem_meta%allow_static, message='input meta should not expose allow_static as file metadata')
    @assertFalse(in_height_meta%allow_static, message='input meta should not expose allow_static as file metadata')
    @assertFalse(in_ds%static, message='input dataset should detect time dimension')
    time_axis = in_ds%time_axis()
    @assertEqual(time_axis%n_times(), 14_i4, message='input time axis length')
    @assertEqual(time_axis%timestamp, end_timestamp, message='input time axis uses end timestamps')
    @assertEqual(time_axis%values, in_ds%t_values, message='input time axis values')
    @assertEqual(time_axis%bounds(1_i4, :), in_ds%t_bounds(:size(in_ds%t_values)), message='input time axis lower bounds')
    @assertEqual(time_axis%bounds(2_i4, :), in_ds%t_bounds(2_i4:), message='input time axis upper bounds')
    @assertEqual(trim(time_axis%units), trim(in_ds%time_units), message='input time axis units')

    allocate(dem_read(grid%nx, grid%ny))
    allocate(dem_sp(grid%nx, grid%ny))
    allocate(dem_i4(grid%nx, grid%ny))
    allocate(dem_int_read(grid%nx, grid%ny))
    allocate(dem_i8(grid%nx, grid%ny))
    allocate(height_read(grid%ncells))
    call in_ds%read("dem", data=dem_read)
    call in_ds%read("dem", data=dem_sp)
    call in_ds%read("dem", data=dem_i4)
    call in_ds%read("dem", data=dem_i8)
    call in_ds%read("dem_int", data=dem_int_read)
    call in_ds%read("height", data=height_read, current_time=datetime("2025-01-11"))
    call in_ds%read_chunk("height", &
      timeframe_start=datetime("2025-01-10"), &
      timeframe_end=datetime("2025-01-15"), &
      times=times, data=h_chunk)
    call in_ds%close()

    @assertEqual(dem_i4, nint(dem, i4), message='static read check i4')
    @assertEqual(dem_int_read, nint(dem, i4), message='static integer output read check i4')
    @assertEqual(dem_i8, nint(dem, i8), message='static read check i8')
    @assertEqual(dem_sp, real(dem, sp), tolerance=real(t, sp), message='static read check sp')
    @assertEqual(dem_read, dem, tolerance=t, message='static read check')
    @assertEqual(height_read, heights, tolerance=t, message='temporal read check')
    @assertEqual(size(times), size(h_chunk, dim=2))
    @assertTrue(times(1)==datetime("2025-01-11"), message='checking start time frame')
    @assertTrue(times(size(Times))==datetime("2025-01-15"), message='checking end time frame')
    @assertFalse(in_ds%flip_y, "not flipping input since grid is equal")
  end subroutine run_output_case

end module test_mo_grid_io
