module test_mo_message
  use funit
  use mo_message, only: message, warn_message, error_message, def_log_scope, use_log, &
    show_msg, show_warn, show_err, unit_warn, unit_err
  use mo_logging, only: log_unit, log_unit_error, log_level, LOG_INFO, log_set_config
  use logging_test_support, only: save_message_config, restore_message_config
  implicit none
  private
  public :: setup
  public :: teardown
  public :: test_plain_scope_and_advancement
  public :: test_concatenation_and_visibility
  public :: test_plain_warning_and_error_visibility
  public :: test_logging_routing_and_visibility
  public :: test_long_plain_scope_and_absent_allocatables
contains
  @before
  subroutine setup()
    call save_message_config()
  end subroutine setup

  @after
  subroutine teardown()
    call restore_message_config()
  end subroutine teardown

  @test
  subroutine test_plain_scope_and_advancement()
    integer :: unit
    character(len=256) :: line
    open(newunit=unit, status='scratch', action='readwrite')
    call message('A', uni=unit, advance='no')
    call message('B', uni=unit, advance='YES')
    def_log_scope = 'mhm'
    call message('default', uni=unit)
    call message('override', uni=unit, scope='forces')
    call message('root', uni=unit, scope='')
    call message('alias', uni=unit, scope='#')
    call message('', uni=unit, scope='forces')
    rewind(unit)
    read(unit, '(a)') line
    @assertEqual('AB', trim(line))
    read(unit, '(a)') line
    @assertEqual('[mhm] default', trim(line))
    read(unit, '(a)') line
    @assertEqual('[forces] override', trim(line))
    read(unit, '(a)') line
    @assertEqual('root', trim(line))
    read(unit, '(a)') line
    @assertEqual('alias', trim(line))
    read(unit, '(a)') line
    @assertEqual('[forces]', trim(line))
    close(unit)
  end subroutine test_plain_scope_and_advancement

  @test
  subroutine test_concatenation_and_visibility()
    integer :: unit, ios
    character(len=256) :: line
    open(newunit=unit, status='scratch', action='readwrite')
    show_msg = .false.
    call message('hidden', uni=unit)
    call message('1', '2', '3', '4', '5', '6', '7', '8', '9', 'a', 'b', 'c', 'd', 'e', 'f', 'g', uni=unit, show=.true.)
    call message(t02='two ', t04='four', uni=unit, show=.true.)
    rewind(unit)
    read(unit, '(a)') line
    @assertEqual('123456789abcdefg', trim(line))
    read(unit, '(a)') line
    @assertEqual('two four', trim(line))
    read(unit, '(a)', iostat=ios) line
    @assertTrue(ios < 0)
    close(unit)
  end subroutine test_concatenation_and_visibility

  @test
  subroutine test_plain_warning_and_error_visibility()
    integer :: unit, ios
    character(len=256) :: line
    open(newunit=unit, status='scratch', action='readwrite')
    unit_warn = unit
    unit_err = unit
    show_msg = .false.
    def_log_scope = 'mhm'
    call warn_message('warning')
    call error_message('error', raise=.false.)
    show_warn = .false.
    show_err = .false.
    call warn_message('hidden')
    call error_message('hidden', raise=.false.)
    call warn_message('override', show=.true., scope='#')
    call error_message('override', raise=.false., show=.true., scope='forces')
    rewind(unit)
    read(unit, '(a)') line
    @assertEqual('[mhm] warning', trim(line))
    read(unit, '(a)') line
    @assertEqual('[mhm] error', trim(line))
    read(unit, '(a)') line
    @assertEqual('override', trim(line))
    read(unit, '(a)') line
    @assertEqual('[forces] override', trim(line))
    read(unit, '(a)', iostat=ios) line
    @assertTrue(ios < 0)
    close(unit)
  end subroutine test_plain_warning_and_error_visibility

  @test
  subroutine test_long_plain_scope_and_absent_allocatables()
    integer :: unit
    character(len=1024) :: line
    character(:), allocatable :: scope, absent
    open(newunit=unit, status='scratch', action='readwrite')
    scope = repeat('s', 400)
    call message('body', uni=unit, scope=scope)
    def_log_scope = '#'
    call message(t02='root', t04=absent, uni=unit, scope=absent)
    def_log_scope = 'temporary'
    deallocate(def_log_scope)
    call message('reset', uni=unit)
    rewind(unit)
    read(unit, '(a)') line
    @assertEqual('[' // scope // '] body', trim(line))
    read(unit, '(a)') line
    @assertEqual('root', trim(line))
    read(unit, '(a)') line
    @assertEqual('reset', trim(line))
    close(unit)
  end subroutine test_long_plain_scope_and_absent_allocatables

  @test
  subroutine test_logging_routing_and_visibility()
    integer :: unit, ignored_unit, ios
    character(len=256) :: line
    open(newunit=unit, status='scratch', action='readwrite')
    open(newunit=ignored_unit, status='scratch', action='readwrite')
    use_log = .true.
    log_unit = unit
    log_unit_error = unit
    log_level = LOG_INFO
    def_log_scope = 'mhm'
    call message('info', uni=ignored_unit, advance='no', scope='forces')
    call warn_message('warning')
    call error_message('error', raise=.false.)
    call message('hidden', show=.false.)
    show_msg = .false.
    show_warn = .false.
    show_err = .false.
    call message('global info')
    call warn_message('global warning')
    call error_message('global error', raise=.false.)
    call warn_message('hidden', show=.false.)
    call error_message('hidden', raise=.false., show=.false.)
    call warn_message('override', show=.true., scope='#')
    call error_message('override', raise=.false., show=.true., scope='#')
    call log_set_config(log_scope_filter='other')
    call message('filtered', scope='forces', show=.true.)
    call error_message('filtered', raise=.false., scope='forces', show=.true.)
    log_level = 0
    call message('quiet', scope='other', show=.true.)
    rewind(unit)
    read(unit, '(a)') line
    @assertEqual('[forces][INFO] info', trim(line))
    read(unit, '(a)') line
    @assertEqual('[mhm][WARN] warning', trim(line))
    read(unit, '(a)') line
    @assertEqual('[mhm][ERROR] error', trim(line))
    read(unit, '(a)') line
    @assertEqual('[mhm][INFO] global info', trim(line))
    read(unit, '(a)') line
    @assertEqual('[mhm][WARN] global warning', trim(line))
    read(unit, '(a)') line
    @assertEqual('[mhm][ERROR] global error', trim(line))
    read(unit, '(a)') line
    @assertEqual('[WARN] override', trim(line))
    read(unit, '(a)') line
    @assertEqual('[ERROR] override', trim(line))
    read(unit, '(a)', iostat=ios) line
    @assertTrue(ios < 0)
    rewind(ignored_unit)
    read(ignored_unit, '(a)', iostat=ios) line
    @assertTrue(ios < 0)
    close(unit)
    close(ignored_unit)
  end subroutine test_logging_routing_and_visibility
end module test_mo_message
