# Check termination and content independently, including hidden diagnostics.
set(arguments "${CASE}")
execute_process(COMMAND "${PROGRAM}" ${arguments}
  RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT "${result}" STREQUAL "${EXPECTED_EXIT}")
  message(FATAL_ERROR "${CASE}: expected status ${EXPECTED_EXIT}, got ${result}\n${output}${error}")
endif()
set(combined "${output}${error}")
if(NOT "${EXPECTED}" STREQUAL "")
  string(FIND "${combined}" "${EXPECTED}" found)
  if(found EQUAL -1)
    message(FATAL_ERROR "${CASE}: missing '${EXPECTED}'\n${combined}")
  endif()
endif()
if(DEFINED FORBIDDEN AND NOT "${FORBIDDEN}" STREQUAL "")
  string(FIND "${combined}" "${FORBIDDEN}" found)
  if(NOT found EQUAL -1)
    message(FATAL_ERROR "${CASE}: unexpected '${FORBIDDEN}'\n${combined}")
  endif()
endif()
