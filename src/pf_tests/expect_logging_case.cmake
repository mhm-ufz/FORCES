# Check termination and diagnostic content independently, including intentionally hidden messages.
set(arguments)
if(CASE MATCHES "^cli-")
  file(MAKE_DIRECTORY "${CASE_DIRECTORY}")
  set(log_path "${CASE_DIRECTORY}/cli output.log")
  set(previous_contents "Previous log must be replaced.\n")
  file(WRITE "${log_path}" "${previous_contents}")
endif()
if(CASE STREQUAL "cli-help")
  list(APPEND arguments --log-file "${log_path}" --help)
elseif(CASE STREQUAL "cli-version")
  list(APPEND arguments --log-file "${log_path}" --version)
elseif(CASE STREQUAL "cli-file" OR CASE STREQUAL "cli-file-filtered")
  list(APPEND arguments --log-file "${log_path}")
  if(CASE STREQUAL "cli-file-filtered")
    list(APPEND arguments --log-scope other)
  endif()
elseif(CASE STREQUAL "cli-file-missing")
  list(APPEND arguments --log-file --)
elseif(CASE STREQUAL "cli-file-empty")
  list(APPEND arguments --log-file " ")
elseif(CASE STREQUAL "cli-file-fallback")
  file(REMOVE_RECURSE "${CASE_DIRECTORY}/missing")
  list(APPEND arguments --log-file "${CASE_DIRECTORY}/missing/log.txt")
elseif(CASE STREQUAL "scope-bare")
  list(APPEND arguments --log-scope --)
elseif(CASE STREQUAL "scope-root")
  list(APPEND arguments --log-scope "#")
elseif(CASE STREQUAL "scope-forces")
  list(APPEND arguments --log-scope forces)
endif()
list(APPEND arguments "${CASE}")
execute_process(COMMAND "${PROGRAM}" ${arguments}
  RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT "${result}" STREQUAL "${EXPECTED_EXIT}")
  message(FATAL_ERROR "${CASE}: expected status ${EXPECTED_EXIT}, got ${result}\n${output}${error}")
endif()
set(combined "${output}${error}")
if(NOT "${EXPECTED}" STREQUAL "")
  string(FIND "${combined}" "${EXPECTED}" found)
  if(found EQUAL -1)
    message(FATAL_ERROR "${CASE}: missing '${EXPECTED}'\n${combined}")
  endif()
endif()
if(DEFINED FORBIDDEN AND NOT "${FORBIDDEN}" STREQUAL "")
  string(FIND "${combined}" "${FORBIDDEN}" found)
  if(NOT found EQUAL -1)
    message(FATAL_ERROR "${CASE}: unexpected '${FORBIDDEN}'\n${combined}")
  endif()
endif()
if(CASE STREQUAL "cli-help" OR CASE STREQUAL "cli-version")
  file(READ "${log_path}" current_contents)
  if(NOT current_contents STREQUAL previous_contents)
    message(FATAL_ERROR "${CASE}: help/version modified the requested log file")
  endif()
  if(combined MATCHES "\\[(forces|mhm|INFO|FATAL)\\]")
    message(FATAL_ERROR "${CASE}: CLI presentation contains a diagnostic prefix\n${combined}")
  endif()
endif()
if(CASE STREQUAL "cli-file" OR CASE STREQUAL "cli-file-filtered")
  if(NOT combined STREQUAL "")
    message(FATAL_ERROR "${CASE}: redirected diagnostics leaked to stdout/stderr\n${combined}")
  endif()
  file(READ "${log_path}" contents)
  if(CASE STREQUAL "cli-file-filtered")
    if(NOT contents STREQUAL "")
      message(FATAL_ERROR "${CASE}: excluded messages reached the log file\n${contents}")
    endif()
  else()
    string(REPEAT "x" 4096 long_message)
    set(expected_contents "[INFO] root record\n[forces][INFO] library record\n")
    string(APPEND expected_contents "[forces][INFO] ${long_message}\n")
    string(APPEND expected_contents "[forces][WARN] warning record\n[forces][ERROR] recoverable error record\n")
    if(NOT contents STREQUAL expected_contents)
      message(FATAL_ERROR "${CASE}: log contents differ or a long record was wrapped\n${contents}")
    endif()
  endif()
elseif(CASE STREQUAL "cli-file-fallback")
  string(FIND "${error}" "WARNING: Failed to open log file" warning_position)
  if(warning_position EQUAL -1)
    message(FATAL_ERROR "${CASE}: missing logger fallback warning\n${combined}")
  endif()
endif()
if(CASE STREQUAL "cli-version" AND NOT output STREQUAL "1.2.3\n")
  message(FATAL_ERROR "Version output changed: '${output}'")
endif()
